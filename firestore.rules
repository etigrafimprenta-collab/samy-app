rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // SECURITY FIX (encontrado probando en vivo con un candidato nuevo):
    // las colecciones legacy de abajo usaban isAuth() a secas, es decir
    // "cualquier usuario autenticado del proyecto" — con la plataforma
    // multicandidato ya desplegada, eso significa que un usuario de un
    // candidato NUEVO (que no tiene nada que ver con Samy Fidabel) podía
    // leer todo el padrón legacy, y hasta escribir en dia_d_votos /
    // mesa_votacion2025 legacy. isLegacyUser() exige que además tenga un
    // documento en /users (el esquema de un solo candidato), que un
    // usuario de un candidato nuevo nunca tiene.
    function isLegacyUser() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ── Users collection ──────────────────────────────────
    // SECURITY FIX (audit finding V.1): a user could previously write their
    // own `role` field and self-promote to admin. Role changes must now go
    // through the `cambiarRolUsuario` Cloud Function (server-side validated).
    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());

      // Self-signup: a user may create their own profile, but never as admin
      // and never with a plaintext password field.
      allow create: if isAuth() && isOwner(uid) &&
        request.resource.data.role in ['militante', 'user'] &&
        !('password' in request.resource.data.keys());

      // Owner may update their own doc, but never the `role` field, and
      // never write a `password` field (passwords live only in Firebase Auth).
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          !('password' in request.resource.data.keys()));

      allow delete: if isAdmin();
    }

    // ── Voters (padrón) ───────────────────────────────────
    // El padrón es la ÚNICA colección compartida entre todos los
    // candidatos a propósito: es el mismo registro electoral para
    // cualquiera que se presente, no un dato de campaña. Lectura abierta
    // a cualquier usuario autenticado (legacy o de un candidato nuevo);
    // escritura reservada al admin legacy de Samy (isAdmin(), para no
    // romperle su flujo actual) y a superadmin — ningún campaign_admin de
    // un candidato nuevo puede escribir acá.
    match /voters/{voterId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isSuperAdmin();

      // Mejora de privacidad (telefono deja de vivir en el doc principal):
      // firestore.rules no puede ocultar UN campo dentro de un documento
      // permitido — solo el documento entero. Por eso el teléfono se separó
      // a esta subcolección, con su propia regla, mucho más restrictiva que
      // la de arriba. Lectura directa (cliente) solo para superadmin;
      // cualquier otro rol obtiene el teléfono (cuando corresponde, según
      // dueño/asignación) únicamente a través de la Cloud Function
      // `buscarTelefonosPadron`, que usa Admin SDK y por lo tanto no pasa
      // por esta regla. Escritura: mismo criterio que el doc principal de
      // voters (isAdmin()/isSuperAdmin() — el import/actualización del
      // padrón desde Superadmin escribe el teléfono acá directo, client-
      // side); `actualizarTelefonoVotante` (Cloud Function) también escribe
      // acá, pero con Admin SDK, que bypassa esta regla igual.
      match /private/{docId} {
        allow read: if isSuperAdmin();
        allow write: if isAdmin() || isSuperAdmin();
      }
    }

    // ── Saved Records ─────────────────────────────────────
    match /savedRecords/{recordId} {
      allow read: if isLegacyUser() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isLegacyUser() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLegacyUser() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }

    // ── Día D / operativo (previamente sin cobertura — auditoría V.5) ─────
    // Estas colecciones ya se leían/escribían desde el código sin ninguna
    // regla explícita. Se cubren aquí con el mismo criterio que el resto del
    // esquema legacy mientras dure la migración a /candidates/{candidateId}.
    match /config/{docId} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    // ── Metadata del padrón compartido (nombre del último .xlsx cargado) ──
    // Lectura abierta a cualquier candidato (igual criterio que /voters:
    // el padrón es compartido, así que su metadata también) — solo
    // superadmin puede escribirla, se actualiza desde el panel de
    // Superadmin al cargar/actualizar el padrón.
    match /config/padronMeta {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /campaignDrivers2025/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /choferes/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /dia_d_choferes/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /mesa_votacion2025/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_votos/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_transporte/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_estado/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Plataforma multicandidato — /platformUsers y /candidates/{candidateId}/**
    //
    // Los bloques de arriba (users, voters, savedRecords, dia_d_*, etc.)
    // son el esquema legacy de un solo candidato (Samy Fidabel) y se
    // mantienen intactos mientras dura la migración (ver scripts/migrate-
    // to-candidate.js). Una vez migrado y validado, Samy Fidabel opera
    // 100% bajo /candidates/samy-fidabel/** igual que cualquier otro
    // candidato nuevo.
    // ═══════════════════════════════════════════════════════════════════

    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.globalRole == 'superadmin';
    }

    function candidateUserDoc(candidateId) {
      return get(/databases/$(database)/documents/candidates/$(candidateId)/users/$(request.auth.uid)).data;
    }

    function belongsToCandidate(candidateId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/candidates/$(candidateId)/users/$(request.auth.uid));
    }

    // RBAC (Etapa 8, modo compatibilidad): además del `role` legacy
    // (string), un usuario puede tener `roleIds` (array, Etapa 5) con
    // roles ADICIONALES — si cualquiera de esos roleIds coincide con la
    // lista permitida, también pasa. get('roleIds', []) es el accessor
    // seguro de Firestore rules con default: si el campo no existe (el
    // caso de TODOS los usuarios reales hoy, que no tienen roleIds
    // todavía), devuelve [] y .hasAny() da false — cero cambio de
    // comportamiento para nadie que no tenga roleIds asignado.
    //
    // LIMITACIÓN QUE SIGUE VIGENTE (roles de SISTEMA agregados por
    // roleIds, ej. 'coordinator' sumado a un dirigente, sí matchean acá:
    // su id ES el mismo string que `role` ya usa). Lo que esta función
    // JAMÁS resuelve es un rol PERSONALIZADO (id autogenerado de
    // Firestore) — ningún array literal `roles` de ninguna regla de este
    // archivo puede contener un id que no existe todavía cuando se
    // escribió la regla. Para eso está hasEffectivePermission() más abajo.
    function hasCandidateRole(candidateId, roles) {
      return belongsToCandidate(candidateId) && (
        candidateUserDoc(candidateId).role in roles ||
        candidateUserDoc(candidateId).get('roleIds', []).hasAny(roles)
      );
    }

    // ── RBAC dinámico para roles PERSONALIZADOS (auditoría RBAC) ─────────
    // Un rol personalizado no puede resolverse con hasCandidateRole()
    // (arriba) porque su id nunca aparece en ningún array literal de este
    // archivo. La alternativa "correcta" — leer cada doc de
    // candidates/{id}/roles/{roleId} del usuario y evaluar su mapa de
    // permisos+scope DENTRO de la regla — choca con 2 límites reales de
    // Firestore Rules, no con falta de esfuerzo:
    //   1. Presupuesto de 10 get()/exists() por evaluación de regla (documentado
    //      por Firebase) — ya hay colecciones acá que gastan 1-2 en otras
    //      condiciones (isDriverOwner, isOperatorOfVoter); sumar 1 get() por
    //      cada roleId del usuario lo agota rápido.
    //   2. Una query list()/count() sin filtro solo se puede aprobar si la
    //      condición es independiente de resource.data de cada doc — un
    //      alcance own/assigned/team/zone/table por definición SÍ depende
    //      del doc devuelto, así que NUNCA es "list-provable", sin importar
    //      cuánto código se escriba (mismo problema ya documentado en
    //      PROJECT_CONTEXT_MASTER.md §4, encontrado 2 veces en producción).
    //
    // Solución adoptada (decisión explícita, no un atajo): computeEffectivePermissionKeys
    // (src/lib/rolesCandidate.js) precalcula, CADA VEZ que cambian los roles
    // de un usuario o los permisos de un rol, el subconjunto de permisos
    // cuyo alcance otorgado es 'all_candidate'/'all_platform' — los ÚNICOS
    // que no dependen de resource.data — y lo denormaliza en
    // candidates/{id}/users/{uid}.effectivePermissionKeys. Acá solo se lee
    // ese array ya resuelto (mismo get() que ya paga candidateUserDoc(), sin
    // costo adicional), nunca se evalúan roles ni permisos en la regla.
    // Permisos de alcance angosto (own/assigned/team/zone/table) de un rol
    // personalizado NO están acá — siguen siendo solo menú hasta que ese
    // módulo puntual se resuelva vía Cloud Function (fuera de esta etapa).
    function hasEffectivePermission(candidateId, permissionKey) {
      return belongsToCandidate(candidateId) &&
        candidateUserDoc(candidateId).get('effectivePermissionKeys', []).hasAny([permissionKey]);
    }

    // Un mesario solo puede tocar votos de la mesa que tiene asignada,
    // ya sea vía (seccional+mesa) fija o vía la lista mesasAsignadas.
    function isMesarioOfMesa(candidateId, seccional, mesa) {
      return belongsToCandidate(candidateId) &&
        candidateUserDoc(candidateId).role == 'mesario' &&
        (
          (candidateUserDoc(candidateId).seccional == seccional && candidateUserDoc(candidateId).mesa == mesa) ||
          (candidateUserDoc(candidateId).mesasAsignadas is list && mesa in candidateUserDoc(candidateId).mesasAsignadas)
        );
    }

    // Un chofer solo puede tocar lo que corresponde al doc de drivers que
    // tiene vinculado (drivers/{driverId}.usuarioAsignado == su uid) — el
    // mismo vínculo que ya usa el panel de Choferes para "Asignar a Usuario".
    function isDriverOwner(candidateId, driverId) {
      return driverId != null &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/drivers/$(driverId)).data.usuarioAsignado == request.auth.uid;
    }

    // Un operador solo puede tocar electionDayControl del voterId que tiene
    // asignado en callAssignments (mismo doc id: ambas colecciones usan el
    // id de savedRecords como clave) — habilita que el botón "Ya votó" del
    // tab Día D de Centro de Contacto escriba a la fuente única de verdad
    // (electionDayControl.status), no solo a electionStatus como antes.
    function isOperatorOfVoter(candidateId, voterId) {
      return exists(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(voterId)) &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(voterId)).data.assignedUserId == request.auth.uid;
    }

    // Mecanismo NUEVO de mesario (assignedTableUserId en electionDayControl,
    // el que usa Día D Control), en paralelo a isMesarioOfMesa (mecanismo
    // VIEJO, seccional+mesa en el perfil). Ambos coexisten a propósito — ver
    // auditoría Día D: sin esto, marcarVoto() rechazaba a cualquier mesario
    // que solo tuviera el mecanismo nuevo configurado, y el "votó" nunca
    // llegaba a diaD/votes (que es lo que lee Día D Admin).
    function isMesarioOfControlVoter(candidateId, savedRecordId) {
      return savedRecordId != null &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(savedRecordId)).data.assignedTableUserId == request.auth.uid;
    }

    // ── /platformUsers/{uid} — únicamente estado de superadmin ────────
    match /platformUsers/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isSuperAdmin());
      // El primer superadmin se crea con scripts/create-superadmin.js
      // (Admin SDK, bypassa las reglas). A partir de ahí, solo un
      // superadmin existente puede otorgar el rol a otro uid.
      allow write: if isSuperAdmin();
    }

    // ── /userCandidateIndex/{uid} — a qué candidato(s) pertenece un uid ──
    // Mantenido únicamente por las Cloud Functions (Admin SDK) cuando se
    // crea/borra una membresía. Reemplaza a una query collectionGroup
    // sobre "users" filtrada por uid, que Firestore no puede validar como
    // segura (probado en vivo — ver historial). Un solo get() por el
    // propio uid, sin queries cruzando candidatos.
    match /userCandidateIndex/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ── /candidates/{candidateId} — metadata del candidato ─────────────
    match /candidates/{candidateId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'logoUrl', 'primaryColor', 'electionName', 'electionDate', 'lista', 'opcion', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ── /candidates/{candidateId}/users/{uid} — roster + roles ─────────
    match /candidates/{candidateId}/users/{uid} {
      // get() y list() dentro de UN candidato (roster completo) funcionan
      // con la lógica normal de roles — probado en vivo que Firestore sí
      // puede evaluar condiciones con get() a otro documento para list().
      // Lo que NO funciona nunca (probado en vivo, ver /userCandidateIndex
      // más abajo) es una query collectionGroup sobre "users" cruzando
      // candidateId — por eso esa búsqueda ya no se hace acá.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'users.view') ||
        isOwner(uid);

      allow create: if (isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']) || hasEffectivePermission(candidateId, 'users.create')) &&
        request.resource.data.role in ['campaign_admin', 'coordinator', 'dirigente', 'mesario', 'operador', 'chofer', 'viewer', 'auditor'] &&
        !('password' in request.resource.data.keys());

      // REGLA OBLIGATORIA 1: nadie puede modificar su propio role, ni
      // siquiera un campaign_admin. Los cambios de rol van únicamente por
      // la Cloud Function cambiarRolUsuarioCandidato. Se extiende acá
      // mismo a roleIds/primaryRoleId (RBAC, Etapa 5) — aunque hoy ningún
      // módulo todavía LEE esos campos para decidir acceso (siguen siendo
      // aditivos), en cuanto empiecen a usarse de verdad (Etapa 6+) un
      // auto-edit ahí sería una escalada de privilegios idéntica a
      // editarse `role` directamente. Se cierra ahora para no dejar la
      // puerta abierta y tener que acordarse de hacerlo después.
      // Auditoría RBAC: users.edit_role/roles.assign_users de un rol
      // personalizado (alcance amplio) también pueden tocar este doc, pero
      // NUNCA el propio (!isOwner(uid) se mantiene igual que para
      // campaign_admin) — un rol personalizado no puede autoelevarse acá
      // ni por esta vía.
      allow update: if !('password' in request.resource.data.keys()) && (
        isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'users.edit_role') && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'roles.assign_users') && !isOwner(uid)) ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleIds', 'primaryRoleId']))
      );

      allow delete: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'users.disable') && !isOwner(uid));
    }

    // NOTA: no existe /candidates/{candidateId}/voters — el padrón es
    // compartido, vive únicamente en /voters (ver arriba). Ningún
    // candidato tiene su propia copia del padrón.

    // ── /candidates/{candidateId}/savedRecords/{recordId} ──────────────
    match /candidates/{candidateId}/savedRecords/{recordId} {
      // El Centro de Contacto usa el id de este doc como voterId en
      // callAssignments — así que un operador puede leer un registro
      // puntual (get(), nunca list()) si tiene la asignación de ESE
      // voterId a su propio uid. recordId acá == voterId ahí a propósito.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor', 'viewer']) ||
        hasEffectivePermission(candidateId, 'records.view') ||
        (belongsToCandidate(candidateId) && resource.data.uid == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(recordId)).data.assignedUserId == request.auth.uid) ||
        // Día D Control: chofer/mesario leen un registro puntual (get(),
        // nunca list()) si el electionDayControl de ESE mismo voterId
        // (recordId acá == voterId ahí) los tiene asignados.
        (hasCandidateRole(candidateId, ['chofer']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          isDriverOwner(candidateId, get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedDriverId)) ||
        // Vista propia del chofer (renderChoferView): a diferencia del
        // caso de arriba, ESTE sí es válido para list() — chofer_asignado
        // es un campo propio del registro (no de otra colección), así que
        // Firestore puede probar la condición para toda la query
        // where('chofer_asignado','==',driverId) sin tener que mirar cada
        // doc devuelto uno por uno.
        (hasCandidateRole(candidateId, ['chofer']) &&
          resource.data.chofer_asignado != null &&
          isDriverOwner(candidateId, resource.data.chofer_asignado)) ||
        (hasCandidateRole(candidateId, ['mesario']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedTableUserId == request.auth.uid) ||
        // Un dirigente puede ser REASIGNADO a un voterId que no capturó
        // él mismo (assignedLeaderId != uid del que creó el savedRecords)
        // — sin esto solo vería sus propios registros originales, nunca
        // los que un admin le reasigna desde Día D Control.
        (hasCandidateRole(candidateId, ['dirigente']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedLeaderId == request.auth.uid);

      // REGLA OBLIGATORIA 4: dirigente (y roles operativos) solo puede
      // crear/editar/borrar SUS PROPIOS registros. Bug real encontrado en
      // vivo: a diferencia de read/update/delete de este mismo match, a
      // este create le faltaba isSuperAdmin() — un superadmin viendo un
      // candidato (sin roster propio en ese candidateId, por diseño) no
      // podía guardar un votante buscado, aunque sí podía leer/editar/
      // borrar. request.resource.data.uid sigue siendo el uid real del
      // superadmin (lo pone saveRecord() con user.uid), así que no hace
      // falta relajar esa parte de la condición.
      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'coordinator', 'campaign_admin']) &&
          request.resource.data.uid == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'search_voter.create') &&
          request.resource.data.uid == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        hasEffectivePermission(candidateId, 'records.edit') ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.uid == request.auth.uid) ||
        // coordinator ya puede crear/editar callAssignments (ver abajo);
        // esto solo le deja espejar ese mismo dato en el propio
        // savedRecords (ccAssignedUserId) al asignar/reasignar en Centro
        // de Contacto — ningún otro campo del registro.
        (hasCandidateRole(candidateId, ['coordinator']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ccAssignedUserId', 'updatedAt']));

      allow delete: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.uid == request.auth.uid);
    }

    // ── /candidates/{candidateId}/diaD/{diaDDocId} — config/estado global ─
    match /candidates/{candidateId}/diaD/{diaDDocId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/diaD/{diaDDocId}/votes/{voteId} ──────
    // REGLA OBLIGATORIA 5: mesario solo puede marcar votos de su(s)
    // mesa(s) asignada(s) — por el mecanismo viejo (isMesarioOfMesa) O el
    // nuevo (isMesarioOfControlVoter, ver función arriba). Antes solo se
    // aceptaba el viejo, así que el espejo best-effort desde Día D Control
    // (setDiaDStatus → marcarVoto) fallaba en silencio para cualquier
    // mesario asignado solo por assignedTableUserId.
    match /candidates/{candidateId}/diaD/{diaDDocId}/votes/{voteId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor', 'viewer']) ||
        isMesarioOfMesa(candidateId, resource.data.seccional, resource.data.mesa) ||
        isMesarioOfControlVoter(candidateId, resource.data.savedRecordId) ||
        (belongsToCandidate(candidateId) && resource.data.markedBy == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        ((isMesarioOfMesa(candidateId, request.resource.data.seccional, request.resource.data.mesa) ||
          isMesarioOfControlVoter(candidateId, request.resource.data.savedRecordId)) &&
          request.resource.data.markedBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        ((
          (isMesarioOfMesa(candidateId, resource.data.seccional, resource.data.mesa) &&
            isMesarioOfMesa(candidateId, request.resource.data.seccional, request.resource.data.mesa)) ||
          (isMesarioOfControlVoter(candidateId, resource.data.savedRecordId) &&
            isMesarioOfControlVoter(candidateId, request.resource.data.savedRecordId))
        ) && request.resource.data.markedBy == resource.data.markedBy);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/drivers/{driverId} — choferes ────────
    match /candidates/{candidateId}/drivers/{driverId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'drivers.create') ||
        hasEffectivePermission(candidateId, 'drivers.edit') ||
        hasEffectivePermission(candidateId, 'drivers.delete');
    }

    // ── /candidates/{candidateId}/mesarios/{mesarioId} — roster de mesarios,
    // capacitaciones y presencia (mismo criterio de acceso que drivers) ───
    match /candidates/{candidateId}/mesarios/{mesarioId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'table_members.create') ||
        hasEffectivePermission(candidateId, 'table_members.edit') ||
        hasEffectivePermission(candidateId, 'table_members.delete');
    }

    // ── /candidates/{candidateId}/reportPresets/{id} — Reportes Guardados
    // (Etapa 4): presets de filtro para Reportes > Registros. Lectura con
    // los mismos roles que TAB_ROLES.reportes en campaign.js (doc-
    // independiente, seguro para list() sin filtro). Escritura SIN
    // auditor, igual que el resto del archivo (auditLogs/roleAuditLogs/
    // financeAuditLogs/financeAlerts todos excluyen a auditor de write) —
    // un auditor no debería poder borrar/sobreescribir filtros ajenos.
    match /candidates/{candidateId}/reportPresets/{presetId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'reports.view');
      allow write: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
    }

    // ── /candidates/{candidateId}/config/{configId} — p.ej. electionDay ─
    match /candidates/{candidateId}/config/{configId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']) ||
        hasEffectivePermission(candidateId, 'settings.edit');
    }

    // Bloque más específico para config/financeSettings: además de
    // campaign_admin, finance_admin también puede tocar tarifas. Firestore
    // evalúa ambos match blocks para esta misma ruta y permite si CUALQUIERA
    // de los dos lo permite (OR), así que esto amplía el bloque de arriba
    // sin tener que tocarlo ni afectar ningún otro doc de config/*.
    match /candidates/{candidateId}/config/financeSettings {
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
    }

    // ═══════════════════════════════════════════════════════════════════
    // Finanzas de Campaña — Etapa 1 (modelo de datos, permisos, resumen,
    // obligaciones). Reutiliza roles existentes (campaign_admin, auditor)
    // y agrega 3 nuevos (finance_admin, finance_operator, cashier) — ver
    // CANDIDATE_ROLES en functions/src/index.ts. Pagos/comprobantes/
    // liquidaciones/caja quedan para Etapa 2+.
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/financeObligations/{obligationId} ────
    // Separación de funciones (spec sección 7): finance_operator crea sus
    // propias obligaciones y puede seguir editándolas mientras sigan en
    // draft/pending (para corregir antes de que finance_admin las revise),
    // pero nunca puede moverlas a approved/rejected — ese salto de estado
    // le queda vedado por la condición `status in ['draft','pending']` de
    // ambos lados (resource Y request.resource). finance_admin y
    // campaign_admin sí pueden aprobar/rechazar sin esa restricción. La
    // regla de "no autoaprobar lo propio" (misma persona crea+aprueba) no
    // se puede expresar 100% acá sin otro get() — se refuerza en la capa
    // de app (finanzas-candidate.js) que loguea la excepción si ocurre.
    match /candidates/{candidateId}/financeObligations/{obligationId} {
      // Auditoría RBAC: solo se cablea LECTURA (finance.view) para roles
      // personalizados — las escrituras tienen una máquina de estados
      // delicada (draft/pending/approved/paid) que ya está expresada campo
      // por campo; ampliarla con un permiso genérico relajaría esas
      // transiciones sin querer. Queda para una revisión aparte, no
      // apurada dentro de esta migración.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator']) &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        (hasCandidateRole(candidateId, ['finance_operator']) &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status in ['draft', 'pending'] &&
          request.resource.data.status in ['draft', 'pending']) ||
        // cashier no "edita" obligaciones — pero recalcularEstadoObligacion()
        // (en firebaseCandidate.js) le pisa el status como efecto colateral
        // automático de marcar un pago como pagado/revertido. Se restringe
        // a solo esos 2 campos y a los 3 estados que ese cálculo puede
        // producir, para que no sea una puerta de edición general.
        (hasCandidateRole(candidateId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['approved', 'partially_paid', 'paid']);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/financeAuditLogs/{logId} ─────────────
    // A diferencia de auditLogs (arriba, Admin-SDK-only): acá SÍ escribe
    // el cliente, porque las aprobaciones/rechazos de Finanzas ocurren
    // client-side, no vía Cloud Function. Append-only: nunca se edita ni
    // se borra desde el cliente (sección 14 del spec).
    match /candidates/{candidateId}/financeAuditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_audit');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier']) &&
          request.resource.data.performedBy == request.auth.uid);

      allow update, delete: if false;
    }

    // ── /candidates/{candidateId}/financePayments/{paymentId} ─────────
    // Etapa 2. Quién crea el pago: campaign_admin/finance_admin/cashier
    // (finance_operator NO crea pagos — sección 7 del spec, su rol es
    // cargar la obligación y el comprobante). Aprobar/rechazar/revertir:
    // finance_admin/campaign_admin. Marcar como pagado ("ejecuta el
    // pago"): cashier además de finance_admin/campaign_admin.
    // finance_operator solo puede tocar receiptUrl/notes (adjuntar
    // comprobante a un pago que ya existe), igual que en financeObligations.
    match /candidates/{candidateId}/financePayments/{paymentId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'cashier']) &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        (hasCandidateRole(candidateId, ['cashier']) &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'paid') ||
        (hasCandidateRole(candidateId, ['finance_operator']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'notes', 'updatedAt']));

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/financeReceipts/{receiptId} ─────────
    // Metadata en Firestore del archivo que vive en Storage (ver
    // storage.rules) — quien puede subir puede crear este doc; nadie lo
    // edita (los comprobantes no se "corrigen", se vuelven a subir).
    match /candidates/{candidateId}/financeReceipts/{receiptId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier']) &&
          request.resource.data.uploadedBy == request.auth.uid);

      allow update: if false;
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
    }

    // ── /candidates/{candidateId}/paymentBatches/{batchId} ─────────────
    // Etapa 3. payPaymentBatch() (en firebaseCandidate.js) es lo único que
    // toca paymentIds/status/paidBy/paidAt al ejecutar una liquidación —
    // por eso cashier necesita poder escribir esos campos puntuales, igual
    // que ya puede hacerlo sobre financeObligations.
    match /candidates/{candidateId}/paymentBatches/{batchId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator']) &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        (hasCandidateRole(candidateId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentIds', 'status', 'paidBy', 'paidAt', 'updatedAt']) &&
          request.resource.data.status in ['paid', 'partially_paid']);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/cashAccounts/{accountId} ─────────────
    match /candidates/{candidateId}/cashAccounts/{accountId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_cash');
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/cashMovements/{movementId} ───────────
    // cashier puede crear (markFinancePaymentAsPaid auto-genera un egreso
    // cuando se le pasa cashAccountId) pero no editar/borrar movimientos
    // ya creados — eso queda para finance_admin/campaign_admin.
    match /candidates/{candidateId}/cashMovements/{movementId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_cash');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'cashier']) &&
          request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
    }

    // ── /candidates/{candidateId}/financeAlerts/{alertId} ──────────────
    // Etapa 4. calculateFinanceAlerts() (client-computed, mismo patrón que
    // electionDayAlerts de Día D Control) las genera y las persiste;
    // resolveFinanceAlert() solo cambia status/resolvedAt/resolvedBy.
    match /candidates/{candidateId}/financeAlerts/{alertId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);

      allow update: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']));

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Roles y Permisos — Etapa 1-2 (catálogo/motor en código y Firestore,
    // ver src/lib/rbacCatalog.js y rolesCandidate.js). Este modelo nuevo
    // convive con el sistema viejo (hasCandidateRole sobre users.role):
    // todavía NO reemplaza ninguna regla existente, es aditivo. Solo
    // campaign_admin administra roles por ahora (igual que ya administra
    // cambios de rol vía Cloud Function) — se abre a más roles cuando
    // exista de verdad la delegación de "gestión de roles" como permiso.
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/roles/{roleId} ───────────────────────
    // Auditoría RBAC: create/update/delete de DEFINICIONES de rol se
    // dejan deliberadamente SIN hasEffectivePermission() — a diferencia de
    // users.edit_role/roles.assign_users (que solo tocan OTRO usuario,
    // nunca a uno mismo), roles.edit permitiría a un rol personalizado
    // editar su PROPIO documento de rol y auto-otorgarse cualquier permiso
    // sin ningún "!isOwner" que lo frene — es una vía de autoescalada real,
    // no un descuido. Se mantiene campaign_admin-only, igual que hoy.
    match /candidates/{candidateId}/roles/{roleId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/roleAuditLogs/{logId} ────────────────
    // Inmutable desde el cliente (sección 15 del pedido): se crea, nunca
    // se edita ni se borra.
    match /candidates/{candidateId}/roleAuditLogs/{logId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'roles.view_audit');
      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && request.resource.data.performedBy == request.auth.uid);
      allow update, delete: if false;
    }

    // ── /candidates/{candidateId}/auditLogs/{logId} ────────────────────
    // REGLA OBLIGATORIA 7: auditor (y campaign_admin) solo lectura de
    // auditLogs. Nunca se escribe desde el cliente — solo las Cloud
    // Functions (Admin SDK) escriben acá.
    match /candidates/{candidateId}/auditLogs/{logId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'audit.view');
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Centro de Contacto Electoral — llamadas, seguimiento e incidencias.
    // voterId acá siempre es el id de un doc de savedRecords (donde ya
    // viven teléfono/dirección/flags), NO del padrón compartido /voters.
    // Regla común a las 5 colecciones: campaign_admin/coordinator ven y
    // escriben todo dentro de SU candidato; operador solo lee/escribe lo
    // que tiene asignado a SU propio uid (resource.data.assignedUserId).
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/callAssignments/{voterId} ────────────
    match /candidates/{candidateId}/callAssignments/{voterId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.assign_voters');

      // Un operador puede actualizar el status de SU propia asignación
      // (ej: pending -> in_progress al llamar) pero nunca reasignarse a
      // sí mismo ni a otro operador — assignedUserId no puede cambiar.
      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.assign_voters') ||
        (hasCandidateRole(candidateId, ['operador']) &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId);
    }

    // ── /candidates/{candidateId}/electionStatus/{voterId} ─────────────
    match /candidates/{candidateId}/electionStatus/{voterId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.update_status') ||
        (hasCandidateRole(candidateId, ['operador']) && request.resource.data.assignedUserId == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.update_status') ||
        (hasCandidateRole(candidateId, ['operador']) &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/calls/{callId} — historial, inmutable ─
    match /candidates/{candidateId}/calls/{callId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasEffectivePermission(candidateId, 'contact_center.call') &&
          request.resource.data.operatorUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          request.resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.operatorUserId == request.auth.uid);

      // El historial de llamadas no se edita ni se borra desde el
      // cliente, ni siquiera el operador que la registró.
      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/followUps/{followUpId} ────────────────
    match /candidates/{candidateId}/followUps/{followUpId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.create_followup') ||
        (hasCandidateRole(candidateId, ['operador']) && request.resource.data.assignedUserId == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
    }

    // ── /candidates/{candidateId}/incidents/{incidentId} ────────────────
    match /candidates/{candidateId}/incidents/{incidentId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      // chofer/dirigente/mesario reportan incidencias desde su propia
      // vista operativa (Día D Control) — mismo criterio que operador:
      // basta con que se reporten a sí mismos como reportedBy, sin
      // importar a quién quede asignada (assignedUserId, ver
      // wireAccionRapida en dia-d-control-candidate.js).
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasEffectivePermission(candidateId, 'election_day_control.create_incident') && request.resource.data.reportedBy == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador', 'chofer', 'dirigente', 'mesario']) && request.resource.data.reportedBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ═══════════════════════════════════════════════════════════════════
    // Día D Control — operación electoral en vivo (distinto del Centro de
    // Contacto, que es llamadas PREVIAS). assignedLeaderId/assignedTableUserId
    // guardan el uid del dirigente/mesario directamente; assignedDriverId
    // guarda el id del doc en drivers (isDriverOwner resuelve el uid real).
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/electionDayControl/{voterId} ─────────
    // operador se agregó para que "Ya votó" en el tab Día D de Centro de
    // Contacto escriba acá (fuente única de verdad de "votó", ver auditoría
    // Día D) — a diferencia de dirigente/mesario/chofer, operador no tiene
    // un campo assignedXxx propio en este doc: se valida directo contra
    // callAssignments (isOperatorOfVoter), que usa el mismo id de documento.
    match /candidates/{candidateId}/electionDayControl/{voterId} {
      // Auditoría RBAC: solo se cablea la LECTURA (election_day_control.
      // view_operations) para un rol personalizado — las reasignaciones
      // (assign_driver/leader/table_member) quedan deliberadamente sin
      // enforcement nuevo acá: es la colección más sensible en vivo el día
      // de la elección, y sus condiciones de escritura ya son intrincadas
      // (comparan cada campo assignedXxx contra el valor previo); ampliar
      // eso con permisos personalizados queda para una revisión aparte,
      // no apurada dentro de esta migración.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.assignedLeaderId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['mesario']) && resource.data.assignedTableUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.assignedDriverId)) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId));

      // Creación lazy: la primera vez que cualquier rol operativo toca un
      // voterId se crea el doc, siempre y cuando se cree apuntándose a sí
      // mismo (nadie crea un doc "asignado a otro" salvo admin/coordinator).
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['dirigente']) && request.resource.data.assignedLeaderId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['mesario']) && request.resource.data.assignedTableUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, request.resource.data.assignedDriverId)) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId));

      // Los roles operativos pueden actualizar el estado de SU propio
      // voterId, pero nunca reasignar chofer/dirigente/mesario — eso es
      // exclusivo de campaign_admin/coordinator (REGLA: solo admin reasigna).
      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.assignedLeaderId == request.auth.uid &&
          request.resource.data.assignedLeaderId == resource.data.assignedLeaderId &&
          request.resource.data.assignedDriverId == resource.data.assignedDriverId &&
          request.resource.data.assignedTableUserId == resource.data.assignedTableUserId) ||
        (hasCandidateRole(candidateId, ['mesario']) && resource.data.assignedTableUserId == request.auth.uid &&
          request.resource.data.assignedTableUserId == resource.data.assignedTableUserId &&
          request.resource.data.assignedDriverId == resource.data.assignedDriverId &&
          request.resource.data.assignedLeaderId == resource.data.assignedLeaderId) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.assignedDriverId) &&
          request.resource.data.assignedDriverId == resource.data.assignedDriverId &&
          request.resource.data.assignedLeaderId == resource.data.assignedLeaderId &&
          request.resource.data.assignedTableUserId == resource.data.assignedTableUserId) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId) &&
          request.resource.data.assignedDriverId == resource.data.assignedDriverId &&
          request.resource.data.assignedLeaderId == resource.data.assignedLeaderId &&
          request.resource.data.assignedTableUserId == resource.data.assignedTableUserId);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayMovements/{movementId} ────
    // Historial inmutable. Lectura completa solo admin/coordinator — los
    // roles operativos solo pueden listar SUS PROPIOS movimientos
    // (updatedBy == uid), nunca los de otro, ni siquiera del mismo votante.
    match /candidates/{candidateId}/electionDayMovements/{movementId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'chofer', 'operador']) && resource.data.updatedBy == request.auth.uid);

      allow create: if (isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'dirigente', 'mesario', 'chofer', 'operador'])) &&
        request.resource.data.updatedBy == request.auth.uid;

      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayAlerts/{alertId} ──────────
    // Generadas por el panel de admin (client-computed) — nunca por el
    // cliente de un rol operativo. Un operativo solo ve las suyas.
    match /candidates/{candidateId}/electionDayAlerts/{alertId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'chofer']) && resource.data.assignedUserId == request.auth.uid);
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayReports/{reportId} ────────
    match /candidates/{candidateId}/electionDayReports/{reportId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'reports.view');
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }
  }
}

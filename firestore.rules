rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // SECURITY FIX (encontrado probando en vivo con un candidato nuevo):
    // las colecciones legacy de abajo usaban isAuth() a secas, es decir
    // "cualquier usuario autenticado del proyecto" — con la plataforma
    // multicandidato ya desplegada, eso significa que un usuario de un
    // candidato NUEVO (que no tiene nada que ver con Samy Fidabel) podía
    // leer todo el padrón legacy, y hasta escribir en dia_d_votos /
    // mesa_votacion2025 legacy. isLegacyUser() exige que además tenga un
    // documento en /users (el esquema de un solo candidato), que un
    // usuario de un candidato nuevo nunca tiene.
    function isLegacyUser() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ── Users collection ──────────────────────────────────
    // SECURITY FIX (audit finding V.1): a user could previously write their
    // own `role` field and self-promote to admin. Role changes must now go
    // through the `cambiarRolUsuario` Cloud Function (server-side validated).
    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());

      // Self-signup: a user may create their own profile, but never as admin
      // and never with a plaintext password field.
      allow create: if isAuth() && isOwner(uid) &&
        request.resource.data.role in ['militante', 'user'] &&
        !('password' in request.resource.data.keys());

      // Owner may update their own doc, but never the `role` field, and
      // never write a `password` field (passwords live only in Firebase Auth).
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          !('password' in request.resource.data.keys()));

      allow delete: if isAdmin();
    }

    // ── Voters (padrón) ───────────────────────────────────
    // El padrón es la ÚNICA colección compartida entre todos los
    // candidatos a propósito: es el mismo registro electoral para
    // cualquiera que se presente, no un dato de campaña. Lectura abierta
    // a cualquier usuario autenticado (legacy o de un candidato nuevo);
    // escritura reservada al admin legacy de Samy (isAdmin(), para no
    // romperle su flujo actual) y a superadmin — ningún campaign_admin de
    // un candidato nuevo puede escribir acá.
    match /voters/{voterId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isSuperAdmin();

      // Mejora de privacidad (telefono deja de vivir en el doc principal):
      // firestore.rules no puede ocultar UN campo dentro de un documento
      // permitido — solo el documento entero. Por eso el teléfono se separó
      // a esta subcolección, con su propia regla, mucho más restrictiva que
      // la de arriba. Lectura directa (cliente) solo para superadmin;
      // cualquier otro rol obtiene el teléfono (cuando corresponde, según
      // dueño/asignación) únicamente a través de la Cloud Function
      // `buscarTelefonosPadron`, que usa Admin SDK y por lo tanto no pasa
      // por esta regla. Escritura: mismo criterio que el doc principal de
      // voters (isAdmin()/isSuperAdmin() — el import/actualización del
      // padrón desde Superadmin escribe el teléfono acá directo, client-
      // side); `actualizarTelefonoVotante` (Cloud Function) también escribe
      // acá, pero con Admin SDK, que bypassa esta regla igual.
      match /private/{docId} {
        allow read: if isSuperAdmin();
        allow write: if isAdmin() || isSuperAdmin();
      }
    }

    // ── Saved Records ─────────────────────────────────────
    match /savedRecords/{recordId} {
      allow read: if isLegacyUser() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isLegacyUser() && request.resource.data.uid == request.auth.uid;
      allow delete: if isLegacyUser() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }

    // ── Día D / operativo (previamente sin cobertura — auditoría V.5) ─────
    // Estas colecciones ya se leían/escribían desde el código sin ninguna
    // regla explícita. Se cubren aquí con el mismo criterio que el resto del
    // esquema legacy mientras dure la migración a /candidates/{candidateId}.
    match /config/{docId} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    // ── Metadata del padrón compartido (nombre del último .xlsx cargado) ──
    // Lectura abierta a cualquier candidato (igual criterio que /voters:
    // el padrón es compartido, así que su metadata también) — solo
    // superadmin puede escribirla, se actualiza desde el panel de
    // Superadmin al cargar/actualizar el padrón.
    match /config/padronMeta {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /campaignDrivers2025/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /choferes/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /dia_d_choferes/{id} {
      allow read: if isLegacyUser();
      allow write: if isAdmin();
    }

    match /mesa_votacion2025/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_votos/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_transporte/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    match /dia_d_estado/{id} {
      allow read: if isLegacyUser();
      allow write: if isLegacyUser();
    }

    // ═══════════════════════════════════════════════════════════════════
    // Plataforma multicandidato — /platformUsers y /candidates/{candidateId}/**
    //
    // Los bloques de arriba (users, voters, savedRecords, dia_d_*, etc.)
    // son el esquema legacy de un solo candidato (Samy Fidabel) y se
    // mantienen intactos mientras dura la migración (ver scripts/migrate-
    // to-candidate.js). Una vez migrado y validado, Samy Fidabel opera
    // 100% bajo /candidates/samy-fidabel/** igual que cualquier otro
    // candidato nuevo.
    // ═══════════════════════════════════════════════════════════════════

    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.globalRole == 'superadmin';
    }

    function candidateUserDoc(candidateId) {
      return get(/databases/$(database)/documents/candidates/$(candidateId)/users/$(request.auth.uid)).data;
    }

    function belongsToCandidate(candidateId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/candidates/$(candidateId)/users/$(request.auth.uid));
    }

    // RBAC (Etapa 8, modo compatibilidad): además del `role` legacy
    // (string), un usuario puede tener `roleIds` (array, Etapa 5) con
    // roles ADICIONALES — si cualquiera de esos roleIds coincide con la
    // lista permitida, también pasa. get('roleIds', []) es el accessor
    // seguro de Firestore rules con default: si el campo no existe (el
    // caso de TODOS los usuarios reales hoy, que no tienen roleIds
    // todavía), devuelve [] y .hasAny() da false — cero cambio de
    // comportamiento para nadie que no tenga roleIds asignado.
    //
    // LIMITACIÓN QUE SIGUE VIGENTE (roles de SISTEMA agregados por
    // roleIds, ej. 'coordinator' sumado a un dirigente, sí matchean acá:
    // su id ES el mismo string que `role` ya usa). Lo que esta función
    // JAMÁS resuelve es un rol PERSONALIZADO (id autogenerado de
    // Firestore) — ningún array literal `roles` de ninguna regla de este
    // archivo puede contener un id que no existe todavía cuando se
    // escribió la regla. Para eso está hasEffectivePermission() más abajo.
    function hasCandidateRole(candidateId, roles) {
      return belongsToCandidate(candidateId) && (
        candidateUserDoc(candidateId).role in roles ||
        candidateUserDoc(candidateId).get('roleIds', []).hasAny(roles)
      );
    }

    // "Cajero de campo" (auto-cajero desde dirigente) — flag ADICIONAL a
    // `role`, nunca lo reemplaza: un dirigente sigue siendo role:'dirigente'
    // y además puede tener isFieldCashier:true (lo pone la Cloud Function
    // de auto-enrolamiento en cashierFunds.ts, nunca el cliente — mismo
    // criterio write:false de las colecciones de Cajeros DD). Solo se
    // consulta en los 2 puntos de lectura de Cajeros DD de abajo — nunca en
    // Caja general ni en el resto de Finanzas, para no ampliar sin querer
    // ningún otro permiso legacy de 'cashier'.
    function isFieldCashier(candidateId) {
      return belongsToCandidate(candidateId) &&
        candidateUserDoc(candidateId).get('isFieldCashier', false) == true;
    }

    // ── RBAC dinámico para roles PERSONALIZADOS (auditoría RBAC) ─────────
    // Un rol personalizado no puede resolverse con hasCandidateRole()
    // (arriba) porque su id nunca aparece en ningún array literal de este
    // archivo. La alternativa "correcta" — leer cada doc de
    // candidates/{id}/roles/{roleId} del usuario y evaluar su mapa de
    // permisos+scope DENTRO de la regla — choca con 2 límites reales de
    // Firestore Rules, no con falta de esfuerzo:
    //   1. Presupuesto de 10 get()/exists() por evaluación de regla (documentado
    //      por Firebase) — ya hay colecciones acá que gastan 1-2 en otras
    //      condiciones (isDriverOwner, isOperatorOfVoter); sumar 1 get() por
    //      cada roleId del usuario lo agota rápido.
    //   2. Una query list()/count() sin filtro solo se puede aprobar si la
    //      condición es independiente de resource.data de cada doc — un
    //      alcance own/assigned/team/zone/table por definición SÍ depende
    //      del doc devuelto, así que NUNCA es "list-provable", sin importar
    //      cuánto código se escriba (mismo problema ya documentado en
    //      PROJECT_CONTEXT_MASTER.md §4, encontrado 2 veces en producción).
    //
    // Solución adoptada (decisión explícita, no un atajo): computeScopedPermissions
    // (src/lib/rolesCandidate.js) precalcula, CADA VEZ que cambian los roles
    // de un usuario o los permisos de un rol, para CADA permiso otorgado, la
    // lista COMPLETA de alcances (own/assigned/team/zone/polling_place/
    // table/all_candidate/all_platform) — y lo denormaliza en
    // candidates/{id}/users/{uid}.scopedPermissions (mapa permiso→[alcances]).
    // Acá solo se lee ese mapa ya resuelto (mismo get() que ya paga
    // candidateUserDoc(), sin costo adicional) — nunca se evalúan roles ni
    // permisos en la regla.
    //
    // hasEffectivePermission(): alcance amplio (all_candidate/all_platform)
    // — no depende de resource.data, sirve para get() Y list()/count() sin
    // filtro, para cualquier colección.
    //
    // hasScopedPermission(): ¿el usuario tiene ESTE alcance puntual
    // otorgado para este permiso? Por sí sola NO alcanza — cada regla de
    // colección todavía tiene que comparar el campo correspondiente del
    // recurso (resource.data.seccional/local/mesa/teamId/uid) contra el
    // perfil del usuario, y la CONSULTA del cliente tiene que traer el
    // where() que hace que esa comparación sea "list-provable" (ver
    // canAccessSavedRecordByScope más abajo, y getSavedRecordsByScope en
    // firebaseCandidate.js, que arma esa consulta).
    function hasEffectivePermission(candidateId, permissionKey) {
      return belongsToCandidate(candidateId) && (
        hasScopedPermission(candidateId, permissionKey, 'all_candidate') ||
        hasScopedPermission(candidateId, permissionKey, 'all_platform')
      );
    }

    function hasScopedPermission(candidateId, permissionKey, scope) {
      return belongsToCandidate(candidateId) &&
        scope in candidateUserDoc(candidateId).get('scopedPermissions', {}).get(permissionKey, []);
    }

    // ── Scopes restringidos para savedRecords (auditoría RBAC) ──────────
    // Un rol personalizado con alcance own/team/zone/polling_place/table
    // para 'records.view'/'records.edit' ya se hace cumplir de verdad acá,
    // comparando el campo correspondiente del propio savedRecords contra
    // el perfil del usuario (zoneIds/pollingPlaceIds/tableIds/teamId en
    // candidates/{id}/users/{uid}). 'assigned' se resuelve aparte (ver
    // isAssignedToSavedRecord) porque el dato vive en electionDayControl,
    // otra colección — no es list-provable, get()/getRecordsByIds()
    // puntual únicamente (ver firebaseCandidate.js).
    function canAccessSavedRecordByScope(candidateId, permissionKey, data) {
      return belongsToCandidate(candidateId) && (
        (hasScopedPermission(candidateId, permissionKey, 'own') && data.uid == request.auth.uid) ||
        (hasScopedPermission(candidateId, permissionKey, 'team') &&
          data.teamId != null && data.teamId == candidateUserDoc(candidateId).get('teamId', null)) ||
        (hasScopedPermission(candidateId, permissionKey, 'zone') &&
          data.seccional in candidateUserDoc(candidateId).get('zoneIds', [])) ||
        (hasScopedPermission(candidateId, permissionKey, 'polling_place') &&
          data.local in candidateUserDoc(candidateId).get('pollingPlaceIds', [])) ||
        (hasScopedPermission(candidateId, permissionKey, 'table') &&
          data.mesa in candidateUserDoc(candidateId).get('tableIds', []))
      );
    }

    // 'assigned' vive en electionDayControl (assignedLeaderId/
    // assignedTableUserId), no en el propio savedRecords — get() puntual,
    // nunca válido para list() sin filtro (ver nota arriba). El cliente ya
    // resuelve esto con 2 queries a electionDayControl (doc-independientes,
    // where('assignedLeaderId'/'assignedTableUserId','==',uid)) + get()
    // puntual por id (getRecordsByIds, patrón ya existente en el código).
    function isAssignedToSavedRecord(candidateId, permissionKey, recordId) {
      return hasScopedPermission(candidateId, permissionKey, 'assigned') &&
        exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
        (
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedLeaderId == request.auth.uid ||
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedTableUserId == request.auth.uid
        );
    }

    // Un mesario solo puede tocar votos de la mesa que tiene asignada,
    // ya sea vía (seccional+mesa) fija o vía la lista mesasAsignadas.
    //
    // ALTA UNIFICADA DE MESARIO — 3 cambios aditivos:
    // 1) `role == 'mesario'` directo no alcanzaba para alguien que tiene
    //    otro rol primario y 'mesario' sumado por roleIds (mecanismo de
    //    multi-rol que usa la reutilización de cuenta existente, ver
    //    crearUsuarioCandidato) — se agrega el mismo OR que ya usa
    //    hasCandidateRole() en el resto de este archivo. Nunca resta
    //    acceso a nadie que ya lo tenía por `role`.
    // 2) BUG REAL encontrado probando contra el padrón real (local
    //    "COL.NAC. FERNANDO DE LA MORA", Mesa 1): `seccional` viene
    //    INCONSISTENTE por votante dentro de la MISMA mesa física — de
    //    350 votantes reales, 176 no tienen seccional cargado y el resto
    //    se reparte en 4 valores distintos. Exigir que coincida con
    //    seccional (aunque fuera además de local+mesa) le habría negado a
    //    un mesario real el acceso a una porción de sus propios votantes/
    //    votos. `local+mesa` sí identifica la mesa física sin ambigüedad,
    //    así que CUANDO el perfil tiene `local` seteado, es la ÚNICA
    //    fuente de verdad (ya no se exige además que coincida seccional).
    // 3) Perfiles legado sin `local` (de antes de este cambio) siguen
    //    funcionando exactamente igual que siempre: seccional+mesa.
    function isMesarioOfMesa(candidateId, seccional, local, mesa) {
      return belongsToCandidate(candidateId) &&
        (candidateUserDoc(candidateId).role == 'mesario' ||
          'mesario' in candidateUserDoc(candidateId).get('roleIds', [])) &&
        (
          (candidateUserDoc(candidateId).get('local', null) != null
            ? (candidateUserDoc(candidateId).local == local && candidateUserDoc(candidateId).mesa == mesa)
            : (candidateUserDoc(candidateId).seccional == seccional && candidateUserDoc(candidateId).mesa == mesa)) ||
          (candidateUserDoc(candidateId).mesasAsignadas is list && mesa in candidateUserDoc(candidateId).mesasAsignadas)
        );
    }

    // Un chofer solo puede tocar lo que corresponde al doc de drivers que
    // tiene vinculado (drivers/{driverId}.usuarioAsignado == su uid) — el
    // mismo vínculo que ya usa el panel de Choferes para "Asignar a Usuario".
    function isDriverOwner(candidateId, driverId) {
      return driverId != null &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/drivers/$(driverId)).data.usuarioAsignado == request.auth.uid;
    }

    // FIX DE SEGURIDAD (auditoría RBAC, ronda 3 — chofer, antes documentado
    // sin corregir): isDriverOwner() solo prueba que el driverId es
    // genuinamente del chofer que llama — no prueba que ESE voterId
    // puntual le fue puesto en su ruta. Sin esto, un chofer real (con un
    // doc de drivers legítimo) podía crear electionDayControl para
    // CUALQUIER elector del candidato con solo poner su propio driverId.
    // Fuente autoritativa: cualquiera de los 2 mecanismos reales por los
    // que un elector queda "en la ruta" de un chofer —
    //   1) manual: savedRecords.chofer_asignado (pestaña Choferes, solo
    //      admin/coordinator escriben ese campo — ver `allow update` de
    //      savedRecords)
    //   2) automático: driverZoneVoters/{voterId}.driverId (Zonas de
    //      búsqueda, escrito únicamente por Cloud Function — ver
    //      driverZones.ts, `allow write: if false` en esa colección)
    // Ninguno de los 2 es editable por el propio chofer.
    function isVoterAssignedToDriver(candidateId, voterId, driverId) {
      return driverId != null && (
        (exists(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)).data.get('chofer_asignado', null) == driverId) ||
        (exists(/databases/$(database)/documents/candidates/$(candidateId)/driverZoneVoters/$(voterId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/driverZoneVoters/$(voterId)).data.get('driverId', null) == driverId)
      );
    }

    // Variante de isVoterAssignedToDriver() que NO recibe driverId del
    // cliente — resuelve directo si EL QUE LLAMA es el chofer de este
    // voterId, leyendo únicamente campos server-side (savedRecords.
    // chofer_asignado / driverZoneVoters.driverId) y cruzándolos con
    // isDriverOwner(). Usada por incidents/electionDayMovements (donde no
    // tiene sentido que el documento cargue un assignedDriverId propio).
    function isDriverOfVoter(candidateId, voterId) {
      return (exists(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)) &&
          isDriverOwner(candidateId, get(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)).data.get('chofer_asignado', null))) ||
        (exists(/databases/$(database)/documents/candidates/$(candidateId)/driverZoneVoters/$(voterId)) &&
          isDriverOwner(candidateId, get(/databases/$(database)/documents/candidates/$(candidateId)/driverZoneVoters/$(voterId)).data.get('driverId', null)));
    }

    // Un operador solo puede tocar electionDayControl del voterId que tiene
    // asignado en callAssignments (mismo doc id: ambas colecciones usan el
    // id de savedRecords como clave) — habilita que el botón "Ya votó" del
    // tab Día D de Centro de Contacto escriba a la fuente única de verdad
    // (electionDayControl.status), no solo a electionStatus como antes.
    function isOperatorOfVoter(candidateId, voterId) {
      return exists(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(voterId)) &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(voterId)).data.assignedUserId == request.auth.uid;
    }

    // Mecanismo NUEVO de mesario (assignedTableUserId en electionDayControl,
    // el que usa Día D Control), en paralelo a isMesarioOfMesa (mecanismo
    // VIEJO, seccional+mesa en el perfil). Ambos coexisten a propósito — ver
    // auditoría Día D: sin esto, marcarVoto() rechazaba a cualquier mesario
    // que solo tuviera el mecanismo nuevo configurado, y el "votó" nunca
    // llegaba a diaD/votes (que es lo que lee Día D Admin).
    function isMesarioOfControlVoter(candidateId, savedRecordId) {
      return savedRecordId != null &&
        get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(savedRecordId)).data.assignedTableUserId == request.auth.uid;
    }

    // FIX DE SEGURIDAD (auditoría RBAC, ronda 4 — incidents/
    // electionDayMovements): ambas colecciones son secundarias
    // (auditoría/seguimiento, con id de documento AUTOGENERADO —
    // addDoc(), no voterId) y confiaban únicamente en un campo
    // autodeclarado por el cliente en la misma escritura (reportedBy/
    // updatedBy == self) para decidir si el elector le correspondía —
    // cualquier rol operativo podía fabricar una incidencia o un
    // movimiento sobre CUALQUIER voterId del candidato. Este helper
    // resuelve, por rol, si el que llama tiene una relación YA
    // ESTABLECIDA con `voterId` (nunca con datos de la misma escritura):
    //   - dirigente: assignedLeaderId en electionDayControl, o —si ese
    //     doc todavía no existe, mismo caso límite que ya resuelve el
    //     `create` de electionDayControl— savedRecords.uid (el votante
    //     que capturó).
    //   - mesario: assignedTableUserId en electionDayControl (siempre
    //     existe: lo crea admin/coordinator antes de que el mesario opere).
    //   - chofer: isDriverOfVoter() (savedRecords.chofer_asignado o
    //     driverZoneVoters, cruzado con isDriverOwner — sin pedirle
    //     ningún dato al cliente).
    //   - operador: isOperatorOfVoter() (callAssignments).
    // logDiaDMovement() SIEMPRE se llama DESPUÉS de que el propio
    // setDiaDStatus() ya escribió electionDayControl con éxito (ver
    // firebaseCandidate.js) — para ese momento el campo assignedXxx
    // correspondiente YA está en el estado que este helper necesita, así
    // que ninguna transición legítima se rompe.
    function hasAuthoritativeLinkToVoter(candidateId, voterId) {
      return
        (hasCandidateRole(candidateId, ['dirigente']) &&
          ((exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(voterId)) &&
            get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(voterId)).data.get('assignedLeaderId', null) == request.auth.uid) ||
           (exists(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)) &&
            get(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)).data.uid == request.auth.uid))) ||
        (hasCandidateRole(candidateId, ['mesario']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(voterId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(voterId)).data.get('assignedTableUserId', null) == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOfVoter(candidateId, voterId)) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId));
    }

    // ═══════════════════════════════════════════════════════════════════
    // Helpers — Organización Electoral (Fase 1 de cimiento, aditivo)
    //
    // Réplica deliberada de 2 patrones ya probados en este archivo, NO un
    // mecanismo nuevo:
    //   1. userCandidateIndex (abajo) → acá /userOrganizationIndex/{uid},
    //      mismo motivo: una query collectionGroup sobre "users" cruzando
    //      organizationId no es demostrable como segura para list(), así
    //      que la pertenencia se resuelve con UN get() al propio uid,
    //      mantenido solo por Cloud Functions (Admin SDK).
    //   2. canAccessSavedRecordByScope (arriba) → acá
    //      canAccessIncidentByTerritory, mismo criterio: el scope
    //      territorial se compara contra un campo (`territorialAssignments`)
    //      que vive en el MISMO doc que ya se lee para resolver el rol, así
    //      que no agrega ningún get() adicional al presupuesto de la regla.
    //
    // hasOrganizationRole()/isOrganizationMember() son doc-independientes
    // (dependen solo de userOrganizationIndex del propio caller) — por lo
    // tanto SÍ pueden avalar list()/count() sin filtro, igual que
    // hasCandidateRole(). canAccessIncidentByTerritory() SÍ depende de
    // resource.data — solo es válida para get() puntual o para list()/
    // count() cuya query ya trae un where() de igualdad sobre el mismo
    // campo (mismo patrón ya usado en canAccessSavedRecordByScope, que la
    // limitación documentada arriba en hasCandidateRole exige respetar).
    // ═══════════════════════════════════════════════════════════════════

    function userOrgIndexDoc() {
      return get(/databases/$(database)/documents/userOrganizationIndex/$(request.auth.uid)).data;
    }

    // `active` (default true si el campo faltara) permite a
    // desactivarUsuarioOrganizacion (Cloud Function) revocar acceso real
    // de un apoderado/organization_admin sin borrar su entrada del índice
    // — mismo criterio que `status` en candidates/{id}/users, pero acá SÍ
    // se hace cumplir en la regla porque userOrganizationIndex (a
    // diferencia del roster de candidato) es la fuente de autorización.
    function isOrganizationMember(organizationId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/userOrganizationIndex/$(request.auth.uid)) &&
        organizationId in userOrgIndexDoc() &&
        userOrgIndexDoc()[organizationId].get('active', true) == true;
    }

    function userOrgEntry(organizationId) {
      return userOrgIndexDoc()[organizationId];
    }

    function hasOrganizationRole(organizationId, roles) {
      return isOrganizationMember(organizationId) && userOrgEntry(organizationId).role in roles;
    }

    // 'all_organization' no necesita comparar territorio — otorgado,
    // siempre pasa, igual criterio que all_candidate/all_platform en
    // hasScopedPermission. Los demás scopes comparan el campo territorial
    // correspondiente del recurso contra la lista asignada al usuario en
    // userOrganizationIndex — misma estructura que canAccessSavedRecordByScope.
    //
    // OBLIGATORIO (hardening Fase 2.5): esta función tiene una réplica en
    // TypeScript, membershipCanAccessTerritory() en functions/src/lib.ts
    // (Cloud Functions no puede importar Firestore Rules — duplicación
    // inevitable, no un descuido). Cualquier cambio ACÁ exige el mismo
    // cambio ahí, y correr functions/test/territory.parity.test.ts (compara
    // ambas contra la misma matriz de casos y falla si divergen).
    //
    // AUTORIZACIÓN FASE 3C §1/§14: 'district' es el nombre canónico nuevo,
    // 'zone' es alias legacy — ambos comparan contra territorialAssignments.
    // distritos, ninguno tiene más permisos que el otro (test BC). No se
    // migra ningún documento existente.
    //
    // AUTORIZACIÓN FASE 3C §2: un veedor sin estadoAcreditacion=='ACREDITADO'
    // no accede a NINGÚN territorio — PENDIENTE/OBSERVADO/REVOCADO/VENCIDO
    // quedan todos denegados acá, sin excepción por scope.
    function canAccessIncidentByTerritory(organizationId, data) {
      return isOrganizationMember(organizationId) &&
      (
        userOrgEntry(organizationId).role != 'veedor' ||
        userOrgEntry(organizationId).get('estadoAcreditacion', 'PENDIENTE') == 'ACREDITADO'
      ) && (
        userOrgEntry(organizationId).scope == 'all_organization' ||
        (userOrgEntry(organizationId).scope in ['zone', 'district'] &&
          data.distrito in userOrgEntry(organizationId).territorialAssignments.get('distritos', [])) ||
        (userOrgEntry(organizationId).scope == 'department' &&
          data.departamento in userOrgEntry(organizationId).territorialAssignments.get('departamentos', [])) ||
        (userOrgEntry(organizationId).scope == 'polling_place' &&
          data.local in userOrgEntry(organizationId).territorialAssignments.get('locales', [])) ||
        (userOrgEntry(organizationId).scope == 'table' &&
          data.mesa in userOrgEntry(organizationId).territorialAssignments.get('mesas', []))
      ) && (
        // affectedCandidateIds vacío en el propio recurso = incidencia de
        // toda la organización, visible para cualquier scope territorial
        // que ya haya calzado arriba. Si el usuario tiene su propio
        // candidateIds[] de alcance restringido (no todas las candidaturas
        // de la organización), la incidencia debe pisar al menos una.
        userOrgEntry(organizationId).territorialAssignments.get('candidateIds', []).size() == 0 ||
        data.affectedCandidateIds.size() == 0 ||
        data.affectedCandidateIds.hasAny(userOrgEntry(organizationId).territorialAssignments.get('candidateIds', []))
      );
    }

    // ── /platformUsers/{uid} — únicamente estado de superadmin ────────
    match /platformUsers/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isSuperAdmin());
      // El primer superadmin se crea con scripts/create-superadmin.js
      // (Admin SDK, bypassa las reglas). A partir de ahí, solo un
      // superadmin existente puede otorgar el rol a otro uid.
      allow write: if isSuperAdmin();
    }

    // ── /userCandidateIndex/{uid} — a qué candidato(s) pertenece un uid ──
    // Mantenido únicamente por las Cloud Functions (Admin SDK) cuando se
    // crea/borra una membresía. Reemplaza a una query collectionGroup
    // sobre "users" filtrada por uid, que Firestore no puede validar como
    // segura (probado en vivo — ver historial). Un solo get() por el
    // propio uid, sin queries cruzando candidatos.
    match /userCandidateIndex/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ── /candidates/{candidateId} — metadata del candidato ─────────────
    match /candidates/{candidateId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'logoUrl', 'primaryColor', 'electionName', 'electionDate', 'lista', 'opcion', 'slogan', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ── /candidates/{candidateId}/users/{uid} — roster + roles ─────────
    match /candidates/{candidateId}/users/{uid} {
      // get() y list() dentro de UN candidato (roster completo) funcionan
      // con la lógica normal de roles — probado en vivo que Firestore sí
      // puede evaluar condiciones con get() a otro documento para list().
      // Lo que NO funciona nunca (probado en vivo, ver /userCandidateIndex
      // más abajo) es una query collectionGroup sobre "users" cruzando
      // candidateId — por eso esa búsqueda ya no se hace acá.
      // Auditoría RBAC (unificación): Dirigentes y Operadores (rbacCatalog.js)
      // no son colecciones propias — son un filtro de UI sobre ESTA MISMA
      // colección (users). leaders.*/operators.* se cablean acá, como
      // ramas adicionales a users.*, para que un rol personalizado con
      // esos permisos no dependa de tener ADEMÁS users.* (desalineación
      // encontrada en la auditoría: el catálogo los presenta como
      // independientes, pero físicamente gobiernan el mismo documento).
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'users.view') ||
        hasEffectivePermission(candidateId, 'leaders.view') ||
        hasEffectivePermission(candidateId, 'operators.view') ||
        isOwner(uid);

      allow create: if (isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']) ||
          hasEffectivePermission(candidateId, 'users.create') || hasEffectivePermission(candidateId, 'operators.create')) &&
        request.resource.data.role in ['campaign_admin', 'coordinator', 'dirigente', 'mesario', 'operador', 'chofer', 'viewer', 'auditor'] &&
        !('password' in request.resource.data.keys());

      // REGLA OBLIGATORIA 1: nadie puede modificar su propio role, ni
      // siquiera un campaign_admin. Los cambios de rol van únicamente por
      // la Cloud Function cambiarRolUsuarioCandidato.
      //
      // FIX DE SEGURIDAD (auditoría RBAC, ronda 2): la lista de campos
      // vedados al self-edit era solo ['role','roleIds','primaryRoleId'] —
      // dejaba afuera TODO lo demás que este mismo archivo usa para
      // decidir autorización/scope sobre ESTE MISMO doc, encontrado
      // grepeando cada `candidateUserDoc(candidateId).xxx` /
      // `.get('xxx', ...)` del archivo: `scopedPermissions` (el mapa que
      // hasEffectivePermission()/hasScopedPermission() leen — el más
      // grave: permitía autootorgarse CUALQUIER permiso con alcance
      // all_candidate, incluido users.create, o sea toma de control total
      // del candidato desde cualquier rol), `teamId`, `zoneIds`,
      // `pollingPlaceIds`, `tableIds` (los 4 que consume
      // canAccessSavedRecordByScope) y `seccional`/`mesa`/`mesasAsignadas`
      // (los que consume isMesarioOfMesa). `local` se agrega también por
      // ser el campo gemelo de `pollingPlaceIds` en el resto del código,
      // aunque hoy ninguna regla lea `candidateUserDoc(...).local`
      // directamente (defensivo, mismo criterio que ya se usa acá con
      // primaryRoleId). Bloquear estos campos en el self-edit no le quita
      // nada al uso legítimo (nombre/teléfono/email/proponente siguen
      // editables) — solo impide que un usuario se autoasigne el scope de
      // otro.
      //
      // Auditoría RBAC: users.edit_role/roles.assign_users de un rol
      // personalizado (alcance amplio) también pueden tocar este doc, pero
      // NUNCA el propio (!isOwner(uid) se mantiene igual que para
      // campaign_admin) — un rol personalizado no puede autoelevarse acá
      // ni por esta vía.
      allow update: if !('password' in request.resource.data.keys()) && (
        isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'users.edit_role') && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'roles.assign_users') && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'leaders.edit_role') && !isOwner(uid)) ||
        // operators.manage_payment: acotado a los 2 campos que en verdad
        // administra (montoEntregado/cadenciaPago, ver operador-candidate.js)
        // — no una puerta de edición general del doc como users.edit_role.
        (hasEffectivePermission(candidateId, 'operators.manage_payment') && !isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['montoEntregado', 'cadenciaPago', 'updatedAt'])) ||
        (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'roleIds', 'primaryRoleId', 'scopedPermissions', 'isFieldCashier',
          'mesa', 'mesasAsignadas', 'tableIds', 'seccional', 'zoneIds', 'pollingPlaceIds', 'local', 'teamId'
        ]))
      );

      allow delete: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'users.disable') && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'leaders.delete') && !isOwner(uid)) ||
        (hasEffectivePermission(candidateId, 'operators.delete') && !isOwner(uid));
    }

    // NOTA: no existe /candidates/{candidateId}/voters — el padrón es
    // compartido, vive únicamente en /voters (ver arriba). Ningún
    // candidato tiene su propia copia del padrón.

    // ── /candidates/{candidateId}/savedRecords/{recordId} ──────────────
    match /candidates/{candidateId}/savedRecords/{recordId} {
      // El Centro de Contacto usa el id de este doc como voterId en
      // callAssignments — así que un operador puede leer un registro
      // puntual (get(), nunca list()) si tiene la asignación de ESE
      // voterId a su propio uid. recordId acá == voterId ahí a propósito.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor', 'viewer']) ||
        hasEffectivePermission(candidateId, 'records.view') ||
        (belongsToCandidate(candidateId) && resource.data.uid == request.auth.uid) ||
        // Scopes restringidos (auditoría RBAC) para un rol personalizado:
        // team/zone/polling_place/table comparan el propio savedRecords
        // contra el perfil del usuario — 'own' ya cubierto arriba (regla
        // preexistente, cualquiera puede leer lo suyo). 'assigned' aparte,
        // no depende de resource.data del propio doc.
        canAccessSavedRecordByScope(candidateId, 'records.view', resource.data) ||
        isAssignedToSavedRecord(candidateId, 'records.view', recordId) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/callAssignments/$(recordId)).data.assignedUserId == request.auth.uid) ||
        // Día D Control: chofer/mesario leen un registro puntual (get(),
        // nunca list()) si el electionDayControl de ESE mismo voterId
        // (recordId acá == voterId ahí) los tiene asignados.
        (hasCandidateRole(candidateId, ['chofer']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          isDriverOwner(candidateId, get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedDriverId)) ||
        // Vista propia del chofer (renderChoferView): a diferencia del
        // caso de arriba, ESTE sí es válido para list() — chofer_asignado
        // es un campo propio del registro (no de otra colección), así que
        // Firestore puede probar la condición para toda la query
        // where('chofer_asignado','==',driverId) sin tener que mirar cada
        // doc devuelto uno por uno.
        (hasCandidateRole(candidateId, ['chofer']) &&
          resource.data.chofer_asignado != null &&
          isDriverOwner(candidateId, resource.data.chofer_asignado)) ||
        (hasCandidateRole(candidateId, ['mesario']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedTableUserId == request.auth.uid) ||
        // Vista propia del mesario, para resaltar "nuestros" (savedRecords
        // ya capturados por el candidato en SU mesa) — igual patrón que la
        // rama de chofer_asignado de arriba: local+mesa son campos propios
        // del registro, así que Firestore puede probar la condición para
        // toda la query where('local','==',x).where('mesa','==',y) sin
        // mirar cada doc uno por uno. Acotado a mesarios con `local`
        // seteado (los del flujo unificado nuevo) — nunca amplía el
        // acceso más allá de la mesa que ya tienen asignada.
        (hasCandidateRole(candidateId, ['mesario']) &&
          candidateUserDoc(candidateId).get('local', null) != null &&
          resource.data.local == candidateUserDoc(candidateId).local &&
          resource.data.mesa == candidateUserDoc(candidateId).mesa) ||
        // Un dirigente puede ser REASIGNADO a un voterId que no capturó
        // él mismo (assignedLeaderId != uid del que creó el savedRecords)
        // — sin esto solo vería sus propios registros originales, nunca
        // los que un admin le reasigna desde Día D Control.
        (hasCandidateRole(candidateId, ['dirigente']) &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/electionDayControl/$(recordId)).data.assignedLeaderId == request.auth.uid);

      // REGLA OBLIGATORIA 4: dirigente (y roles operativos) solo puede
      // crear/editar/borrar SUS PROPIOS registros. Bug real encontrado en
      // vivo: a diferencia de read/update/delete de este mismo match, a
      // este create le faltaba isSuperAdmin() — un superadmin viendo un
      // candidato (sin roster propio en ese candidateId, por diseño) no
      // podía guardar un votante buscado, aunque sí podía leer/editar/
      // borrar. request.resource.data.uid sigue siendo el uid real del
      // superadmin (lo pone saveRecord() con user.uid), así que no hace
      // falta relajar esa parte de la condición.
      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'coordinator', 'campaign_admin']) &&
          request.resource.data.uid == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'search_voter.create') &&
          request.resource.data.uid == request.auth.uid) ||
        // Scope angosto de search_voter.create (zona/local/mesa/equipo):
        // restringe QUÉ votante del padrón puede guardar como contacto
        // (según el seccional/local/mesa/teamId que traiga el registro
        // nuevo), no solo que se autoasigne como dueño.
        (canAccessSavedRecordByScope(candidateId, 'search_voter.create', request.resource.data) &&
          request.resource.data.uid == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        hasEffectivePermission(candidateId, 'records.edit') ||
        canAccessSavedRecordByScope(candidateId, 'records.edit', resource.data) ||
        isAssignedToSavedRecord(candidateId, 'records.edit', recordId) ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.uid == request.auth.uid) ||
        // coordinator ya puede crear/editar callAssignments (ver abajo);
        // esto solo le deja espejar ese mismo dato en el propio
        // savedRecords (ccAssignedUserId) al asignar/reasignar en Centro
        // de Contacto — ningún otro campo del registro.
        (hasCandidateRole(candidateId, ['coordinator']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ccAssignedUserId', 'updatedAt']));

      allow delete: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.uid == request.auth.uid);
    }

    // ── /candidates/{candidateId}/diaD/{diaDDocId} — config/estado global ─
    match /candidates/{candidateId}/diaD/{diaDDocId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/diaD/{diaDDocId}/votes/{voteId} ──────
    // REGLA OBLIGATORIA 5: mesario solo puede marcar votos de su(s)
    // mesa(s) asignada(s) — por el mecanismo viejo (isMesarioOfMesa) O el
    // nuevo (isMesarioOfControlVoter, ver función arriba). Antes solo se
    // aceptaba el viejo, así que el espejo best-effort desde Día D Control
    // (setDiaDStatus → marcarVoto) fallaba en silencio para cualquier
    // mesario asignado solo por assignedTableUserId.
    match /candidates/{candidateId}/diaD/{diaDDocId}/votes/{voteId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor', 'viewer']) ||
        isMesarioOfMesa(candidateId, resource.data.seccional, resource.data.get('local', null), resource.data.mesa) ||
        isMesarioOfControlVoter(candidateId, resource.data.savedRecordId) ||
        (belongsToCandidate(candidateId) && resource.data.markedBy == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        ((isMesarioOfMesa(candidateId, request.resource.data.seccional, request.resource.data.get('local', null), request.resource.data.mesa) ||
          isMesarioOfControlVoter(candidateId, request.resource.data.savedRecordId)) &&
          request.resource.data.markedBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin']) ||
        ((
          (isMesarioOfMesa(candidateId, resource.data.seccional, resource.data.get('local', null), resource.data.mesa) &&
            isMesarioOfMesa(candidateId, request.resource.data.seccional, request.resource.data.get('local', null), request.resource.data.mesa)) ||
          (isMesarioOfControlVoter(candidateId, resource.data.savedRecordId) &&
            isMesarioOfControlVoter(candidateId, request.resource.data.savedRecordId))
        ) && request.resource.data.markedBy == resource.data.markedBy);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/drivers/{driverId} — choferes ────────
    match /candidates/{candidateId}/drivers/{driverId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'drivers.create') ||
        hasEffectivePermission(candidateId, 'drivers.edit') ||
        hasEffectivePermission(candidateId, 'drivers.delete');
    }

    // ── /candidates/{candidateId}/mesarios/{mesarioId} — roster de mesarios,
    // capacitaciones y presencia (mismo criterio de acceso que drivers) ───
    match /candidates/{candidateId}/mesarios/{mesarioId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'table_members.create') ||
        hasEffectivePermission(candidateId, 'table_members.edit') ||
        hasEffectivePermission(candidateId, 'table_members.delete');
    }

    // ── /candidates/{candidateId}/driverZones/{zoneId} — Zonas de búsqueda
    // (Choferes, pestaña nueva). A diferencia de drivers/mesarios (lectura
    // abierta a belongsToCandidate), acá la lectura es más restrictiva a
    // propósito: el pedido exige no exponer ubicación exacta salvo rol
    // autorizado. Toda escritura pasa por Cloud Functions (Admin SDK, ver
    // functions/src/driverZones.ts) para poder auditar en auditLogs y
    // revalidar exclusión mutua en una transacción — el cliente NUNCA
    // escribe acá directo (mismo criterio que auditLogs, línea ~856).
    match /candidates/{candidateId}/driverZones/{zoneId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'driver_zones.view') ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.driverId));
      allow write: if false;
    }

    // ── /candidates/{candidateId}/driverZoneVoters/{voterId} — asignación
    // votante↔zona↔chofer. El ID del documento ES el id de savedRecords
    // (mismo patrón que electionDayControl/{voterId}) — es lo que garantiza
    // que un votante nunca tenga 2 asignaciones activas: ambas escrituras
    // concurrentes apuntan al mismo doc y se resuelven en una sola
    // runTransaction() del lado servidor. allow write:if false porque la
    // revalidación de "no reasignar a alguien ya asignado" solo se puede
    // hacer de forma atómica en una Cloud Function, no en reglas declarativas
    // que comparan un solo doc contra sí mismo.
    match /candidates/{candidateId}/driverZoneVoters/{voterId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'driver_zones.view') ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.driverId));
      allow write: if false;
    }

    // ── /candidates/{candidateId}/reportPresets/{id} — Reportes Guardados
    // (Etapa 4): presets de filtro para Reportes > Registros. Lectura con
    // los mismos roles que TAB_ROLES.reportes en campaign.js (doc-
    // independiente, seguro para list() sin filtro). Escritura SIN
    // auditor, igual que el resto del archivo (auditLogs/roleAuditLogs/
    // financeAuditLogs/financeAlerts todos excluyen a auditor de write) —
    // un auditor no debería poder borrar/sobreescribir filtros ajenos.
    match /candidates/{candidateId}/reportPresets/{presetId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'reports.view');
      allow write: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
    }

    // ── /candidates/{candidateId}/config/{configId} — p.ej. electionDay ─
    match /candidates/{candidateId}/config/{configId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']) ||
        hasEffectivePermission(candidateId, 'settings.edit');
    }

    // Bloque más específico para config/financeSettings: además de
    // campaign_admin, finance_admin también puede tocar tarifas. Firestore
    // evalúa ambos match blocks para esta misma ruta y permite si CUALQUIERA
    // de los dos lo permite (OR), así que esto amplía el bloque de arriba
    // sin tener que tocarlo ni afectar ningún otro doc de config/*.
    match /candidates/{candidateId}/config/financeSettings {
      allow write: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
    }

    // ═══════════════════════════════════════════════════════════════════
    // Finanzas de Campaña — Etapa 1 (modelo de datos, permisos, resumen,
    // obligaciones). Reutiliza roles existentes (campaign_admin, auditor)
    // y agrega 3 nuevos (finance_admin, finance_operator, cashier) — ver
    // CANDIDATE_ROLES en functions/src/index.ts. Pagos/comprobantes/
    // liquidaciones/caja quedan para Etapa 2+.
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/financeObligations/{obligationId} ────
    // Separación de funciones (spec sección 7): finance_operator crea sus
    // propias obligaciones y puede seguir editándolas mientras sigan en
    // draft/pending (para corregir antes de que finance_admin las revise),
    // pero nunca puede moverlas a approved/rejected — ese salto de estado
    // le queda vedado por la condición `status in ['draft','pending']` de
    // ambos lados (resource Y request.resource). finance_admin y
    // campaign_admin sí pueden aprobar/rechazar sin esa restricción. La
    // regla de "no autoaprobar lo propio" (misma persona crea+aprueba) no
    // se puede expresar 100% acá sin otro get() — se refuerza en la capa
    // de app (finanzas-candidate.js) que loguea la excepción si ocurre.
    match /candidates/{candidateId}/financeObligations/{obligationId} {
      // Auditoría RBAC (unificación): las escrituras tienen una máquina de
      // estados delicada (draft/pending/approved/paid) — se preserva
      // EXACTAMENTE la misma restricción de estados que ya rige para
      // finance_operator/cashier, solo agregando la contraparte
      // hasEffectivePermission para que un rol personalizado con el
      // permiso equivalente (alcance all_candidate/all_platform, único
      // que Firestore puede validar de forma genérica) tenga el mismo
      // poder que el rol legacy correspondiente — nunca más.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator']) &&
          request.resource.data.createdBy == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'finance.create_obligation') &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.approve') ||
        hasEffectivePermission(candidateId, 'finance.reject') ||
        (hasCandidateRole(candidateId, ['finance_operator']) &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status in ['draft', 'pending'] &&
          request.resource.data.status in ['draft', 'pending']) ||
        (hasEffectivePermission(candidateId, 'finance.edit_obligation') &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status in ['draft', 'pending'] &&
          request.resource.data.status in ['draft', 'pending']) ||
        // cashier no "edita" obligaciones — pero recalcularEstadoObligacion()
        // (en firebaseCandidate.js) le pisa el status como efecto colateral
        // automático de marcar un pago como pagado/revertido. Se restringe
        // a solo esos 2 campos y a los 3 estados que ese cálculo puede
        // producir, para que no sea una puerta de edición general.
        (hasCandidateRole(candidateId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['approved', 'partially_paid', 'paid']) ||
        (hasEffectivePermission(candidateId, 'finance.pay') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['approved', 'partially_paid', 'paid']);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/financeAuditLogs/{logId} ─────────────
    // A diferencia de auditLogs (arriba, Admin-SDK-only): acá SÍ escribe
    // el cliente, porque las aprobaciones/rechazos de Finanzas ocurren
    // client-side, no vía Cloud Function. Append-only: nunca se edita ni
    // se borra desde el cliente (sección 14 del spec).
    match /candidates/{candidateId}/financeAuditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_audit');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier']) &&
          request.resource.data.performedBy == request.auth.uid);

      allow update, delete: if false;
    }

    // ── /candidates/{candidateId}/financePayments/{paymentId} ─────────
    // Etapa 2. Quién crea el pago: campaign_admin/finance_admin/cashier
    // (finance_operator NO crea pagos — sección 7 del spec, su rol es
    // cargar la obligación y el comprobante). Aprobar/rechazar/revertir:
    // finance_admin/campaign_admin. Marcar como pagado ("ejecuta el
    // pago"): cashier además de finance_admin/campaign_admin.
    // finance_operator solo puede tocar receiptUrl/notes (adjuntar
    // comprobante a un pago que ya existe), igual que en financeObligations.
    match /candidates/{candidateId}/financePayments/{paymentId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'cashier']) &&
          request.resource.data.createdBy == request.auth.uid) ||
        ((hasEffectivePermission(candidateId, 'finance.approve') || hasEffectivePermission(candidateId, 'finance.pay')) &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.approve') ||
        hasEffectivePermission(candidateId, 'finance.reject') ||
        hasEffectivePermission(candidateId, 'finance.reverse_payment') ||
        (hasCandidateRole(candidateId, ['cashier']) &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'paid') ||
        (hasEffectivePermission(candidateId, 'finance.pay') &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'paid') ||
        (hasCandidateRole(candidateId, ['finance_operator']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'notes', 'updatedAt'])) ||
        (hasEffectivePermission(candidateId, 'finance.upload_receipt') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'notes', 'updatedAt']));

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/financeReceipts/{receiptId} ─────────
    // Metadata en Firestore del archivo que vive en Storage (ver
    // storage.rules) — quien puede subir puede crear este doc; nadie lo
    // edita (los comprobantes no se "corrigen", se vuelven a subir).
    match /candidates/{candidateId}/financeReceipts/{receiptId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier']) &&
          request.resource.data.uploadedBy == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'finance.upload_receipt') &&
          request.resource.data.uploadedBy == request.auth.uid);

      allow update: if false;
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);
    }

    // ── /candidates/{candidateId}/paymentBatches/{batchId} ─────────────
    // Etapa 3. payPaymentBatch() (en firebaseCandidate.js) es lo único que
    // toca paymentIds/status/paidBy/paidAt al ejecutar una liquidación —
    // por eso cashier necesita poder escribir esos campos puntuales, igual
    // que ya puede hacerlo sobre financeObligations.
    match /candidates/{candidateId}/paymentBatches/{batchId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator']) &&
          request.resource.data.createdBy == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'finance.create_obligation') &&
          request.resource.data.createdBy == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.approve') ||
        (hasCandidateRole(candidateId, ['cashier']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentIds', 'status', 'paidBy', 'paidAt', 'updatedAt']) &&
          request.resource.data.status in ['paid', 'partially_paid']) ||
        (hasEffectivePermission(candidateId, 'finance.pay') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentIds', 'status', 'paidBy', 'paidAt', 'updatedAt']) &&
          request.resource.data.status in ['paid', 'partially_paid']);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/cashAccounts/{accountId} ─────────────
    match /candidates/{candidateId}/cashAccounts/{accountId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_cash');
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.manage_cash');
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/cashMovements/{movementId} ───────────
    // cashier puede crear (markFinancePaymentAsPaid auto-genera un egreso
    // cuando se le pasa cashAccountId) pero no editar/borrar movimientos
    // ya creados — eso queda para finance_admin/campaign_admin.
    match /candidates/{candidateId}/cashMovements/{movementId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'finance_operator', 'cashier', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view_cash');

      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'cashier']) &&
          request.resource.data.createdBy == request.auth.uid) ||
        (hasEffectivePermission(candidateId, 'finance.manage_cash') &&
          request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.manage_cash');
    }

    // ═══════════════════════════════════════════════════════════════════
    // Cajeros DD (Finanzas → 💵 Cajeros DD) — colecciones PROPIAS y
    // separadas de Caja general (Plan C). Toda escritura pasa por
    // functions/src/cashierFunds.ts (Admin SDK) — write:false acá en las
    // 4 colecciones, sin excepción, ni para superadmin (las Cloud
    // Functions bypasean estas reglas igual). La lectura SÍ se sirve
    // directo del cliente, pero acotada por regla real (no por
    // Cloud Function ni por UI) — ver matriz de autorización.
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/cashierAccounts/{accountId} ──────────
    // cashier: SOLO su propia cuenta (responsibleUserId == su uid) — la
    // condición es un campo del MISMO doc, sin get() cruzado, así que
    // Firestore puede probarla contra una query que filtre por ese mismo
    // campo (ver getCajeroDiaDAccountByResponsible en firebaseCandidate.js,
    // que SIEMPRE incluye where('responsibleUserId','==',uid)).
    // admin (campaign_admin/finance_admin) y superadmin: sin restricción,
    // rama independiente de resource.data — admite también
    // getCajerosDiaDAccounts() sin filtro, sin romper nada.
    match /candidates/{candidateId}/cashierAccounts/{accountId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.cashier_funds.view_all') ||
        ((hasCandidateRole(candidateId, ['cashier']) || isFieldCashier(candidateId)) &&
          resource.data.responsibleUserId == request.auth.uid);
      allow write: if false;
    }

    // ── /candidates/{candidateId}/cashierMovements/{movementId} ────────
    // Mismo criterio que cashierAccounts — responsibleUserId vive
    // denormalizado en CADA movimiento (escrito una sola vez al crearlo
    // en cashierFunds.ts, nunca se actualiza después: inmutable por
    // construcción) para que la condición sea comparable directo contra
    // resource.data, sin get() a la cuenta. Las queries del cliente para
    // un cashier SIEMPRE incluyen where('responsibleUserId','==',uid)
    // (ver getCajeroDiaDMovementsPage) — sin ese filtro, Firestore
    // rechaza la consulta completa (no la filtra mal), así que "leer
    // movimientos de otro cajero por query directa" ya es DENY estructural,
    // no solo una regla que se confía en que nadie va a saltarse.
    match /candidates/{candidateId}/cashierMovements/{movementId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.cashier_funds.view_all') ||
        ((hasCandidateRole(candidateId, ['cashier']) || isFieldCashier(candidateId)) &&
          resource.data.responsibleUserId == request.auth.uid);
      allow write: if false;
    }

    // ── /candidates/{candidateId}/cashierOperations/{operationId} ──────
    // Idempotencia de Cajeros DD (doc-id == operationId) — puramente
    // interno a cashierFunds.ts, ningún cliente necesita leerlo ni
    // escribirlo directo.
    match /candidates/{candidateId}/cashierOperations/{operationId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── /candidates/{candidateId}/cashierBeneficiaryExceptions/{id} ────
    // Autorización de reasistencia de Cajeros DD — la crea y consume
    // exclusivamente cashierFunds.ts (Admin SDK). Lectura para roles
    // admin de Finanzas (visibilidad de qué excepciones se otorgaron) —
    // ningún cashier necesita leer esta colección directo, la usa
    // indirectamente pasando el exceptionId que el admin le comunica.
    match /candidates/{candidateId}/cashierBeneficiaryExceptions/{exceptionId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) ||
        hasEffectivePermission(candidateId, 'finance.cashier_funds.view_all');
      allow write: if false;
    }

    // ── /candidates/{candidateId}/financeAlerts/{alertId} ──────────────
    // Etapa 4. calculateFinanceAlerts() (client-computed, mismo patrón que
    // electionDayAlerts de Día D Control) las genera y las persiste;
    // resolveFinanceAlert() solo cambia status/resolvedAt/resolvedBy.
    match /candidates/{candidateId}/financeAlerts/{alertId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'finance.view');

      allow create: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']);

      allow update: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'finance_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']));

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Roles y Permisos — Etapa 1-2 (catálogo/motor en código y Firestore,
    // ver src/lib/rbacCatalog.js y rolesCandidate.js). Este modelo nuevo
    // convive con el sistema viejo (hasCandidateRole sobre users.role):
    // todavía NO reemplaza ninguna regla existente, es aditivo. Solo
    // campaign_admin administra roles por ahora (igual que ya administra
    // cambios de rol vía Cloud Function) — se abre a más roles cuando
    // exista de verdad la delegación de "gestión de roles" como permiso.
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/roles/{roleId} ───────────────────────
    // Auditoría RBAC: create/update/delete de DEFINICIONES de rol se
    // dejan deliberadamente SIN hasEffectivePermission() — a diferencia de
    // users.edit_role/roles.assign_users (que solo tocan OTRO usuario,
    // nunca a uno mismo), roles.edit permitiría a un rol personalizado
    // editar su PROPIO documento de rol y auto-otorgarse cualquier permiso
    // sin ningún "!isOwner" que lo frene — es una vía de autoescalada real,
    // no un descuido. Se mantiene campaign_admin-only, igual que hoy.
    match /candidates/{candidateId}/roles/{roleId} {
      allow read: if isSuperAdmin() || belongsToCandidate(candidateId);
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/roleAuditLogs/{logId} ────────────────
    // Inmutable desde el cliente (sección 15 del pedido): se crea, nunca
    // se edita ni se borra.
    match /candidates/{candidateId}/roleAuditLogs/{logId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'roles.view_audit');
      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin']) && request.resource.data.performedBy == request.auth.uid);
      allow update, delete: if false;
    }

    // ── /candidates/{candidateId}/auditLogs/{logId} ────────────────────
    // REGLA OBLIGATORIA 7: auditor (y campaign_admin) solo lectura de
    // auditLogs. Nunca se escribe desde el cliente — solo las Cloud
    // Functions (Admin SDK) escriben acá.
    match /candidates/{candidateId}/auditLogs/{logId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'auditor']) ||
        hasEffectivePermission(candidateId, 'audit.view');
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // Centro de Contacto Electoral — llamadas, seguimiento e incidencias.
    // voterId acá siempre es el id de un doc de savedRecords (donde ya
    // viven teléfono/dirección/flags), NO del padrón compartido /voters.
    // Regla común a las 5 colecciones: campaign_admin/coordinator ven y
    // escriben todo dentro de SU candidato; operador solo lee/escribe lo
    // que tiene asignado a SU propio uid (resource.data.assignedUserId).
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/callAssignments/{voterId} ────────────
    match /candidates/{candidateId}/callAssignments/{voterId} {
      // Auditoría RBAC (unificación de scopes): scope 'assigned' para un
      // rol personalizado equivale exactamente a lo que ya tenía
      // hasCandidateRole(['operador']) — mismo campo (assignedUserId),
      // mismo criterio, solo expresado para el motor de permisos nuevo.
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasScopedPermission(candidateId, 'contact_center.view', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.assign_voters');

      // Un operador puede actualizar el status de SU propia asignación
      // (ej: pending -> in_progress al llamar) pero nunca reasignarse a
      // sí mismo ni a otro operador — assignedUserId no puede cambiar.
      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.assign_voters') ||
        (hasScopedPermission(candidateId, 'contact_center.update_status', 'assigned') &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId);
    }

    // ── /candidates/{candidateId}/electionStatus/{voterId} ─────────────
    match /candidates/{candidateId}/electionStatus/{voterId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasScopedPermission(candidateId, 'contact_center.view', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      // FIX DE SEGURIDAD (auditoría RBAC, ronda 2): igual que
      // electionDayControl, este create confiaba en
      // request.resource.data.assignedUserId==self sin comprobar nada
      // previo — un operador podía crear electionStatus para CUALQUIER
      // voterId, sin haber existido nunca un callAssignments real. Se
      // exige ahora isOperatorOfVoter(candidateId, voterId) (la misma
      // fuente autoritativa — callAssignments, solo escribible por
      // campaign_admin/coordinator — que ya usa correctamente
      // electionDayControl para este mismo rol). Verificado que no rompe
      // el flujo real: contactCenter.js solo llama a
      // upsertElectionStatus() para operador con voterIds que YA vienen
      // de getMyCallAssignments() (el registro ni siquiera se carga en
      // pantalla si no está en esa lista), así que
      // request.resource.data.assignedUserId siempre coincide con una
      // asignación preexistente.
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.update_status') ||
        (hasScopedPermission(candidateId, 'contact_center.update_status', 'assigned') &&
          isOperatorOfVoter(candidateId, voterId) && request.resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          isOperatorOfVoter(candidateId, voterId) && request.resource.data.assignedUserId == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.update_status') ||
        (hasScopedPermission(candidateId, 'contact_center.update_status', 'assigned') &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.assignedUserId == resource.data.assignedUserId);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/calls/{callId} — historial, inmutable ─
    match /candidates/{candidateId}/calls/{callId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasScopedPermission(candidateId, 'contact_center.view', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasEffectivePermission(candidateId, 'contact_center.call') &&
          request.resource.data.operatorUserId == request.auth.uid) ||
        (hasScopedPermission(candidateId, 'contact_center.call', 'assigned') &&
          request.resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.operatorUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          request.resource.data.assignedUserId == request.auth.uid &&
          request.resource.data.operatorUserId == request.auth.uid);

      // El historial de llamadas no se edita ni se borra desde el
      // cliente, ni siquiera el operador que la registró.
      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/followUps/{followUpId} ────────────────
    match /candidates/{candidateId}/followUps/{followUpId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        (hasScopedPermission(candidateId, 'contact_center.view', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      // FIX DE SEGURIDAD (auditoría RBAC, ronda 4): antes confiaba
      // únicamente en request.resource.data.assignedUserId==self (mismo
      // patrón ya corregido en electionStatus) — un operador podía crear
      // un followUp para CUALQUIER voterId del candidato. Se exige ahora
      // isOperatorOfVoter(candidateId, voterId) sobre el voterId real del
      // documento (request.resource.data.voterId — acá el id del doc es
      // autogenerado, no el voterId, a diferencia de electionDayControl/
      // electionStatus).
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        hasEffectivePermission(candidateId, 'contact_center.create_followup') ||
        (hasScopedPermission(candidateId, 'contact_center.create_followup', 'assigned') &&
          isOperatorOfVoter(candidateId, request.resource.data.voterId) &&
          request.resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) &&
          isOperatorOfVoter(candidateId, request.resource.data.voterId) &&
          request.resource.data.assignedUserId == request.auth.uid);

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasScopedPermission(candidateId, 'contact_center.create_followup', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
    }

    // ── /candidates/{candidateId}/incidents/{incidentId} ────────────────
    match /candidates/{candidateId}/incidents/{incidentId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'contact_center.view') ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasScopedPermission(candidateId, 'contact_center.view', 'assigned') && resource.data.assignedUserId == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      // FIX DE SEGURIDAD (auditoría RBAC, ronda 4): antes bastaba con
      // reportedBy==self (autodeclarado en la misma escritura) — cualquier
      // rol operativo podía fabricar una incidencia sobre un elector que
      // nunca tuvo relación real con él. reportedBy==self se mantiene
      // (identifica QUIÉN reporta, dato legítimo de autoría), pero ahora
      // se exige ADEMÁS hasAuthoritativeLinkToVoter() — que ESE elector
      // (request.resource.data.voterId) realmente le corresponda según su
      // rol (electionDayControl.assignedLeaderId/assignedTableUserId,
      // isDriverOfVoter() o isOperatorOfVoter(), nunca un campo de esta
      // misma escritura).
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasEffectivePermission(candidateId, 'election_day_control.create_incident') && request.resource.data.reportedBy == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['operador', 'chofer', 'dirigente', 'mesario']) &&
          request.resource.data.reportedBy == request.auth.uid &&
          hasAuthoritativeLinkToVoter(candidateId, request.resource.data.voterId));

      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['operador']) && resource.data.assignedUserId == request.auth.uid);

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ═══════════════════════════════════════════════════════════════════
    // Día D Control — operación electoral en vivo (distinto del Centro de
    // Contacto, que es llamadas PREVIAS). assignedLeaderId/assignedTableUserId
    // guardan el uid del dirigente/mesario directamente; assignedDriverId
    // guarda el id del doc en drivers (isDriverOwner resuelve el uid real).
    // ═══════════════════════════════════════════════════════════════════

    // ── /candidates/{candidateId}/electionDayControl/{voterId} ─────────
    // operador se agregó para que "Ya votó" en el tab Día D de Centro de
    // Contacto escriba acá (fuente única de verdad de "votó", ver auditoría
    // Día D) — a diferencia de dirigente/mesario/chofer, operador no tiene
    // un campo assignedXxx propio en este doc: se valida directo contra
    // callAssignments (isOperatorOfVoter), que usa el mismo id de documento.
    match /candidates/{candidateId}/electionDayControl/{voterId} {
      // Auditoría RBAC: solo se cablea la LECTURA (election_day_control.
      // view_operations) para un rol personalizado — las reasignaciones
      // (assign_driver/leader/table_member) quedan deliberadamente sin
      // enforcement nuevo acá: es la colección más sensible en vivo el día
      // de la elección, y sus condiciones de escritura ya son intrincadas
      // (comparan cada campo assignedXxx contra el valor previo); ampliar
      // eso con permisos personalizados queda para una revisión aparte,
      // no apurada dentro de esta migración.
      // FIX (bug real detectado probando con un chofer real): la "creación
      // lazy" de la que habla el comentario de arriba requiere que
      // dirigente/mesario/chofer puedan hacer getDoc() de un voterId que
      // TODAVÍA no tiene doc — sin esto, Firestore evalúa
      // `resource.data.assignedXxx` sobre un `resource` null y tira error
      // de evaluación (deniega) en vez de simplemente "no existe". No hay
      // datos que proteger en un doc inexistente, así que `resource == null`
      // se puede permitir para cualquiera con algún rol operativo en este
      // candidato — el contenido real sigue protegido por `allow create`.
      // FIX 2 (bug real, encontrado en la misma sesión de pruebas que el
      // de arriba): comparar `resource.data.assignedDriverId` (u otro
      // campo) por punto directo TIRA ERROR DE EVALUACIÓN si esa key no
      // existe en el doc — no es lo mismo que "es null". Eso pasaba con
      // docs creados por confirmZoneAssignment (Zonas de búsqueda), que
      // solo escribe assignedDriverId y deja assignedLeaderId/
      // assignedTableUserId sin esa key — un error de evaluación en
      // CUALQUIER término de un allow (aunque sea uno que ni aplica al
      // caller) tira TODO el allow como denegado, no solo ese término. Se
      // reemplaza cada acceso directo por `.get('campo', null)` (mismo
      // idioma que ya usa este archivo para roleIds más arriba), que
      // trata "key ausente" igual que "null" sin explotar.
      allow read: if isSuperAdmin() ||
        (resource == null && hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'dirigente', 'mesario', 'chofer', 'operador', 'auditor'])) ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.get('assignedLeaderId', null) == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['mesario']) && resource.data.get('assignedTableUserId', null) == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.get('assignedDriverId', null))) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId)) ||
        // Scope 'assigned' de records.view (auditoría RBAC): un rol
        // personalizado sin role legacy dirigente/mesario también necesita
        // poder consultar electionDayControl por assignedLeaderId O
        // assignedTableUserId (getSavedRecordsByScope consulta ambos) —
        // sin esto, solo funcionaba por coincidencia si el usuario
        // TAMBIÉN tenía el role legacy correspondiente.
        (hasScopedPermission(candidateId, 'records.view', 'assigned') &&
          (resource.data.get('assignedLeaderId', null) == request.auth.uid || resource.data.get('assignedTableUserId', null) == request.auth.uid)) ||
        // Unificación RBAC: mismo criterio, ahora para el permiso PROPIO
        // de este módulo (election_day_control.view_operations) — antes
        // solo existía atado a records.view (efecto colateral de la
        // migración de savedRecords). Reasignar (assign_driver/leader/
        // table_member) sigue sin cablear, ver nota arriba.
        (hasScopedPermission(candidateId, 'election_day_control.view_operations', 'assigned') &&
          (resource.data.get('assignedLeaderId', null) == request.auth.uid ||
            resource.data.get('assignedTableUserId', null) == request.auth.uid ||
            isDriverOwner(candidateId, resource.data.get('assignedDriverId', null))));

      // Creación lazy: la primera vez que cierto rol operativo toca un
      // voterId se crea el doc, siempre y cuando se cree apuntándose a sí
      // mismo (nadie crea un doc "asignado a otro" salvo admin/coordinator).
      //
      // FIX DE SEGURIDAD (auditoría rol mesario): la rama de `mesario` que
      // había acá («hasCandidateRole(['mesario']) &&
      // request.resource.data.get('assignedTableUserId', null) ==
      // request.auth.uid») permitía que CUALQUIER mesario se
      // auto-asignara a CUALQUIER voterId del candidato — sin importar
      // mesa/local — con solo poner su propio uid en assignedTableUserId
      // en el create. No hay ningún campo confiable (no editable por el
      // propio cliente en la misma escritura) contra el cual validar
      // "este elector es de este mesario" ANTES de que el doc exista: el
      // único origen legítimo de esa asignación es que un
      // campaign_admin/coordinator la haya hecho ya (assignTableUserToVoter,
      // ver firebaseCandidate.js) — y esa función SIEMPRE crea el doc si
      // no existe, autorizada por la rama de campaign_admin/coordinator de
      // arriba. Por diseño real de la UI (renderMesarioView lee sus
      // votantes vía getElectionDayControlByTableUser, que solo devuelve
      // docs YA creados), el mesario nunca necesita crear este doc desde
      // cero — solo actualizar uno que ya le fue asignado (ver `allow
      // update` abajo, que sí sigue exigiendo assignedTableUserId propio).
      // Quitar esta rama no le saca ninguna capacidad real al mesario.
      // FIX DE SEGURIDAD (auditoría RBAC, ronda 2): la rama de `dirigente`
      // tenía el mismo hueco que tenía `mesario` (auto-claim solo con
      // assignedLeaderId==self, sin comparar contra ninguna fuente
      // previa) — un dirigente podía crearse un electionDayControl para
      // CUALQUIER voterId del candidato, incluso uno jamás capturado por
      // él. A diferencia de mesario, acá SÍ hay un uso legítimo y real de
      // la creación lazy: renderDirigenteView opera sobre sus PROPIOS
      // votantes (getUserRecords, where uid==self) y, para esos, todavía
      // puede no existir electionDayControl la primera vez que clickea un
      // estado — ahí setDiaDStatus() crea el doc con
      // assignedLeaderId=record.uid, que para un registro propio ES su
      // propio uid. Por eso no se puede simplemente quitar la rama como
      // se hizo con mesario (rompería ese primer click) — en cambio, se
      // exige además que savedRecords/{voterId}.uid (quién capturó
      // realmente a ese votante — el dirigente NUNCA puede reescribir el
      // `uid` de un savedRecords ajeno, ver `allow update` de esa
      // colección) coincida con quien está creando. Un dirigente
      // REASIGNADO a un voterId que no capturó (assignedLeaderId
      // distinto de savedRecords.uid) sigue funcionando igual que antes,
      // porque ese camino nunca pasa por acá: lo crea admin/coordinator
      // vía assignLeaderToVoter(), autorizado por la rama de arriba.
      allow create: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['dirigente']) &&
          request.resource.data.get('assignedLeaderId', null) == request.auth.uid &&
          exists(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)) &&
          get(/databases/$(database)/documents/candidates/$(candidateId)/savedRecords/$(voterId)).data.uid == request.auth.uid) ||
        // FIX DE SEGURIDAD (auditoría RBAC, ronda 3): antes solo exigía
        // isDriverOwner() (identidad del chofer) — se agrega
        // isVoterAssignedToDriver() (que ESTE voterId realmente esté en
        // su ruta, por savedRecords.chofer_asignado o driverZoneVoters).
        (hasCandidateRole(candidateId, ['chofer']) &&
          isDriverOwner(candidateId, request.resource.data.get('assignedDriverId', null)) &&
          isVoterAssignedToDriver(candidateId, voterId, request.resource.data.get('assignedDriverId', null))) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId));

      // Los roles operativos pueden actualizar el estado de SU propio
      // voterId, pero nunca reasignar chofer/dirigente/mesario — eso es
      // exclusivo de campaign_admin/coordinator (REGLA: solo admin reasigna).
      allow update: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) ||
        (hasCandidateRole(candidateId, ['dirigente']) && resource.data.get('assignedLeaderId', null) == request.auth.uid &&
          request.resource.data.get('assignedLeaderId', null) == resource.data.get('assignedLeaderId', null) &&
          request.resource.data.get('assignedDriverId', null) == resource.data.get('assignedDriverId', null) &&
          request.resource.data.get('assignedTableUserId', null) == resource.data.get('assignedTableUserId', null)) ||
        (hasCandidateRole(candidateId, ['mesario']) && resource.data.get('assignedTableUserId', null) == request.auth.uid &&
          request.resource.data.get('assignedTableUserId', null) == resource.data.get('assignedTableUserId', null) &&
          request.resource.data.get('assignedDriverId', null) == resource.data.get('assignedDriverId', null) &&
          request.resource.data.get('assignedLeaderId', null) == resource.data.get('assignedLeaderId', null)) ||
        (hasCandidateRole(candidateId, ['chofer']) && isDriverOwner(candidateId, resource.data.get('assignedDriverId', null)) &&
          request.resource.data.get('assignedDriverId', null) == resource.data.get('assignedDriverId', null) &&
          request.resource.data.get('assignedLeaderId', null) == resource.data.get('assignedLeaderId', null) &&
          request.resource.data.get('assignedTableUserId', null) == resource.data.get('assignedTableUserId', null)) ||
        (hasCandidateRole(candidateId, ['operador']) && isOperatorOfVoter(candidateId, voterId) &&
          request.resource.data.get('assignedDriverId', null) == resource.data.get('assignedDriverId', null) &&
          request.resource.data.get('assignedLeaderId', null) == resource.data.get('assignedLeaderId', null) &&
          request.resource.data.get('assignedTableUserId', null) == resource.data.get('assignedTableUserId', null));

      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayMovements/{movementId} ────
    // Historial inmutable. Lectura completa solo admin/coordinator — los
    // roles operativos solo pueden listar SUS PROPIOS movimientos
    // (updatedBy == uid), nunca los de otro, ni siquiera del mismo votante.
    match /candidates/{candidateId}/electionDayMovements/{movementId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'chofer', 'operador']) && resource.data.updatedBy == request.auth.uid);

      // FIX DE SEGURIDAD (auditoría RBAC, ronda 4): antes bastaba con
      // updatedBy==self — cualquier rol operativo podía fabricar historial
      // falso para un voterId ajeno. Se exige ahora ADEMÁS
      // hasAuthoritativeLinkToVoter() para los 4 roles operativos (no para
      // campaign_admin/coordinator, que siguen sin restricción). No rompe
      // logDiaDMovement(): siempre se llama DESPUÉS de que setDiaDStatus()
      // ya escribió electionDayControl con éxito, así que el campo
      // assignedXxx que este helper necesita ya está en el estado correcto.
      allow create: if isSuperAdmin() ||
        (hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']) && request.resource.data.updatedBy == request.auth.uid) ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'chofer', 'operador']) &&
          request.resource.data.updatedBy == request.auth.uid &&
          hasAuthoritativeLinkToVoter(candidateId, request.resource.data.voterId));

      allow update, delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayAlerts/{alertId} ──────────
    // Generadas por el panel de admin (client-computed) — nunca por el
    // cliente de un rol operativo. Un operativo solo ve las suyas.
    match /candidates/{candidateId}/electionDayAlerts/{alertId} {
      allow read: if isSuperAdmin() ||
        hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'election_day_control.view_operations') ||
        (hasCandidateRole(candidateId, ['dirigente', 'mesario', 'chofer']) && resource.data.assignedUserId == request.auth.uid);
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ── /candidates/{candidateId}/electionDayReports/{reportId} ────────
    match /candidates/{candidateId}/electionDayReports/{reportId} {
      allow read: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator', 'auditor']) ||
        hasEffectivePermission(candidateId, 'reports.view');
      allow create, update: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin', 'coordinator']);
      allow delete: if isSuperAdmin() || hasCandidateRole(candidateId, ['campaign_admin']);
    }

    // ═══════════════════════════════════════════════════════════════════
    // Organización Electoral (Fase 1 de cimiento) — bloque nuevo,
    // completamente aditivo. Ninguna colección de arriba se modifica.
    // Módulo de incidencias (electoralIncidents/evidence/writings) NO se
    // agrega todavía — solo la estructura organizacional (Fase 1).
    // ═══════════════════════════════════════════════════════════════════

    // ── /electoralOrganizations/{organizationId} — metadata ────────────
    // Mismo criterio que /candidates/{candidateId}: solo superadmin crea/
    // borra/suspende (campo `estado`). organization_admin puede editar
    // datos estructurales no sensibles (nombre/sigla/logo), nunca `estado`
    // ni vincular/desvincular candidatos (eso son Cloud Functions aparte,
    // ver sección de candidates.organizationId más abajo).
    match /electoralOrganizations/{organizationId} {
      allow read: if isSuperAdmin() || isOrganizationMember(organizationId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (hasOrganizationRole(organizationId, ['organization_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nombre', 'sigla', 'logoUrl', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ── /electoralOrganizations/{organizationId}/users/{uid} — roster ──
    // Roster informativo (mismo propósito que candidates/{id}/users): qué
    // uids pertenecen a esta organización y con qué rol/estado, para
    // listarlos en la UI de organization_admin. La fuente de verdad para
    // AUTORIZACIÓN es siempre /userOrganizationIndex/{uid} (abajo), nunca
    // este roster — mismo criterio que ya usa el modelo por candidato
    // (candidateUserDoc, no un roster aparte).
    match /electoralOrganizations/{organizationId}/users/{uid} {
      allow read: if isSuperAdmin() || isOrganizationMember(organizationId) || isOwner(uid);
      // Nunca se escribe directo desde el cliente — solo Cloud Functions
      // (Admin SDK), igual criterio que candidates/{id}/auditLogs: crear/
      // activar/desactivar/cambiar scope de un apoderado son acciones que
      // deben quedar auditadas server-side, no ediciones libres de doc.
      allow write: if false;
    }

    // ── /userOrganizationIndex/{uid} — pertenencia + rol + scope ───────
    // Solo Cloud Functions escriben (ver upsertUserOrganizationIndex).
    // Lectura: el propio dueño (para que el cliente resuelva su acceso al
    // iniciar sesión, igual que userCandidateIndex) o superadmin.
    match /userOrganizationIndex/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ── /electoralOrganizations/{organizationId}/auditLogs/{logId} ─────
    // Inmutable desde cliente — solo Cloud Functions (Admin SDK) escriben,
    // mismo patrón exacto que candidates/{id}/auditLogs.
    match /electoralOrganizations/{organizationId}/auditLogs/{logId} {
      allow read: if isSuperAdmin() || hasOrganizationRole(organizationId, ['organization_admin']);
      allow write: if false;
    }

    // NOTA: no se agrega match para /orgInvites — sigue el mismo criterio
    // ya usado por /invites: sin reglas propias a propósito, solo Cloud
    // Functions la tocan.

    // ═══════════════════════════════════════════════════════════════════
    // Incidencia Electoral (Fase 2) — núcleo del Módulo Apoderado.
    // Pertenece a la ORGANIZACIÓN (no a un candidato), puede afectar 0
    // (=toda la organización), 1 o varias candidaturas (affectedCandidateIds).
    //
    // DECISIÓN: TODA escritura (crear/editar/cambiar estado/escalar/
    // asignar responsable) pasa por Cloud Functions (Admin SDK) — mismo
    // criterio ya usado en este archivo para driverZoneVoters/roles/
    // auditLogs, acá con más razón todavía: una incidencia jurídica no
    // puede quedar sujeta a que un cliente arme un `update()` con
    // cualquier combinación de campos, necesita validar territorio/
    // candidatura/transición de estado/historial en un solo lugar
    // auditado. `allow write: if false` en las 3 colecciones de abajo.
    //
    // canAccessIncidentByTerritory (definida arriba, dormida desde Fase 1)
    // se activa acá por primera vez.
    match /electoralOrganizations/{organizationId}/electoralIncidents/{incidentId} {
      allow read: if isSuperAdmin() || canAccessIncidentByTerritory(organizationId, resource.data);
      allow write: if false;
    }

    // get() acotado por path (organizationId+incidentId son segmentos de
    // path, no resource.data) — mismo patrón ya usado en
    // isMesarioOfControlVoter/isAssignedToSavedRecord para traer el
    // "padre" desde una subcolección sin costar más de 1 get() extra.
    function incidentTerritoryData(organizationId, incidentId) {
      return get(/databases/$(database)/documents/electoralOrganizations/$(organizationId)/electoralIncidents/$(incidentId)).data;
    }

    // Historial de transiciones de estado — inmutable desde cliente,
    // mismo criterio que roleAuditLogs/auditLogs. La visibilidad de UNA
    // entrada de historial depende del territorio de SU incidencia padre
    // (si no podés ver la incidencia, tampoco su historial).
    match /electoralOrganizations/{organizationId}/electoralIncidents/{incidentId}/history/{historyId} {
      allow read: if isSuperAdmin() || canAccessIncidentByTerritory(organizationId, incidentTerritoryData(organizationId, incidentId));
      allow write: if false;
    }

    // Evidencia — estructura preparada, sin capacidad real de carga
    // todavía (ver auditoría Fase 1 §D: Firebase Storage del proyecto
    // real sigue sin inicializar, y acá no existe mecanismo de hash/
    // cadena de custodia). `allow write: if false` reflejeja que ningún
    // flujo puede escribir acá hoy, ni siquiera Cloud Functions (no hay
    // ninguna función que lo haga en esta fase) — se deja la regla lista
    // para cuando exista el flujo real, en vez de omitir la colección.
    match /electoralOrganizations/{organizationId}/electoralIncidents/{incidentId}/evidence/{evidenceId} {
      allow read: if isSuperAdmin() || canAccessIncidentByTerritory(organizationId, incidentTerritoryData(organizationId, incidentId));
      allow write: if false;
    }

    // ── .../reclamaciones/{reclamacionId} — AUTORIZACIÓN FASE 3C §12 ────
    // Reclamación escrita del veedor (art. 190). Mismo patrón exacto que
    // history/evidence: visibilidad heredada de la incidencia padre, toda
    // escritura (crear/registrar constancia) pasa por Cloud Functions
    // (crearReclamacionIncidencia/registrarConstanciaReclamacion en
    // incidents.ts). NO existe ninguna Cloud Function de borrado — borrado
    // físico es imposible tanto por Rules (`if false`) como porque la
    // función simplemente no existe (test BV).
    match /electoralOrganizations/{organizationId}/electoralIncidents/{incidentId}/reclamaciones/{reclamacionId} {
      allow read: if isSuperAdmin() || canAccessIncidentByTerritory(organizationId, incidentTerritoryData(organizationId, incidentId));
      allow write: if false;
    }

    // ── .../clasificacionHistory/{entryId} — AUTORIZACIÓN FASE 3C §4 ────
    // Historial INMUTABLE de cambios de clasificacionJuridica, separado a
    // propósito del historial de estadoOperativo (`history` de arriba) —
    // un cambio de clasificación jurídica NUNCA debe mezclarse con ni
    // disparar una transición de estadoOperativo (test BM/BN). Solo
    // clasificarIncidenciaJuridicamente (incidents.ts) escribe acá.
    match /electoralOrganizations/{organizationId}/electoralIncidents/{incidentId}/clasificacionHistory/{entryId} {
      allow read: if isSuperAdmin() || canAccessIncidentByTerritory(organizationId, incidentTerritoryData(organizationId, incidentId));
      allow write: if false;
    }

    // ── /legalSources/{sourceId} — AUTORIZACIÓN FASE 3C §11, GLOBAL ─────
    // Metadatos de procedencia (organismo/norma/URL/fecha/checksum) — no es
    // contenido normativo en sí (eso sigue siendo legalBasis), así que se
    // trata como información de auditoría/citación, visible a cualquier
    // autenticado igual que incidentCatalog. Escritura SIEMPRE por Cloud
    // Function (crearFuenteLegal/actualizarFuenteLegal en legalKnowledge.ts,
    // auditada en legalAuditLogs) — mismo criterio `if false` que
    // legalBasis/incidentCatalog.
    match /legalSources/{sourceId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── /incidentCatalog/{catalogId} — catálogo GLOBAL, no por organización ─
    // Mismo razonamiento que legalBasis: un catálogo de tipos de
    // incidencia no es propiedad de una organización particular, así que
    // vive fuera de electoralOrganizations. Lectura abierta a cualquier
    // autenticado (no es información sensible, es taxonomía); escritura
    // ENDURECIDA en Fase 3: antes era `isSuperAdmin()` directo, ahora
    // `if false` — TODA escritura (crear/editar/versionar/activar) pasa
    // por Cloud Functions (functions/src/legalKnowledge.ts) para que
    // quede auditada en legalAuditLogs sin excepción, incluso para
    // superadmin (sección 14 del pedido: "toda modificación debe quedar
    // auditada", sin dejar una puerta de `set()`/`update()` directo que la
    // esquive). No rompe ningún test de Fase 2 (ninguno probaba que
    // superadmin pudiera escribir directo, solo que apoderado no podía).
    match /incidentCatalog/{catalogId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── /legalBasis/{legalBasisId} — Base Jurídica Electoral, GLOBAL ───
    // Fase 3. Un fundamento legal no es propiedad de una organización ni
    // de un candidato — es la misma ley para todos, así que vive fuera de
    // electoralOrganizations (mismo criterio ya aplicado a incidentCatalog).
    //
    // LECTURA: solo status=='VERIFICADO' Y active==true es visible para
    // cualquier autenticado — un BORRADOR/EN_REVISION/OBSOLETO/DEROGADO
    // NUNCA debe llegarle a un apoderado como si fuera derecho vigente
    // (sección 6 y 8 del pedido: nunca mostrar contenido no verificado
    // como confirmado). Superadmin ve todo, para poder gestionar el ciclo
    // completo (verificar, marcar obsoleto, reactivar).
    //
    // ESCRITURA: `if false` siempre — ni siquiera superadmin escribe
    // directo, todo pasa por Cloud Functions (auditoría obligatoria,
    // sección 14) — mismo criterio que incidentCatalog arriba.
    //
    // BORRADO FÍSICO: nunca, ni por Cloud Function (no existe
    // eliminarFundamentoLegal en absoluto) — un fundamento derogado sigue
    // existiendo con status:'DEROGADO', para que cualquier incidencia
    // vieja que lo haya usado (vía legalBasisSnapshot, ver
    // crearIncidenciaElectoral) siga siendo trazable.
    match /legalBasis/{legalBasisId} {
      allow read: if isSuperAdmin() ||
        (isAuth() && resource.data.status == 'VERIFICADO' && resource.data.active == true);
      allow write: if false;
    }

    // ── /legalAuditLogs/{logId} — auditoría de Base Jurídica + Catálogo ─
    // Global (no por organización) — mismo patrón inmutable que
    // electoralOrganizations/{id}/auditLogs: solo Cloud Functions
    // (Admin SDK) escriben, superadmin es el único que lee (contenido
    // interno de gestión jurídica, no operativo de campaña).
    match /legalAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}

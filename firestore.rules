rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Users collection ──────────────────────────────────
    // SECURITY FIX (audit finding V.1): a user could previously write their
    // own `role` field and self-promote to admin. Role changes must now go
    // through the `cambiarRolUsuario` Cloud Function (server-side validated).
    match /users/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isAdmin());

      // Self-signup: a user may create their own profile, but never as admin
      // and never with a plaintext password field.
      allow create: if isAuth() && isOwner(uid) &&
        request.resource.data.role in ['militante', 'user'] &&
        !('password' in request.resource.data.keys());

      // Owner may update their own doc, but never the `role` field, and
      // never write a `password` field (passwords live only in Firebase Auth).
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) &&
          !('password' in request.resource.data.keys()));

      allow delete: if isAdmin();
    }

    // ── Voters (padrón) ───────────────────────────────────
    match /voters/{voterId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Saved Records ─────────────────────────────────────
    match /savedRecords/{recordId} {
      allow read: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
    }

    // ── Día D / operativo (previamente sin cobertura — auditoría V.5) ─────
    // Estas colecciones ya se leían/escribían desde el código sin ninguna
    // regla explícita. Se cubren aquí con el mismo criterio que el resto del
    // esquema legacy mientras dure la migración a /candidates/{candidateId}.
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /campaignDrivers2025/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /choferes/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /dia_d_choferes/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /mesa_votacion2025/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /dia_d_votos/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /dia_d_transporte/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /dia_d_estado/{id} {
      allow read: if isAuth();
      allow write: if isAuth();
    }
  }
}
